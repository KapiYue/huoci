.hc-page { padding-top: 24rpx; }

/* —— 用户头条 —— */
.banner {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx; border-radius: var(--r-lg);
}
.banner-left { display: flex; align-items: center; gap: 24rpx; min-width: 0; }
.avatar {
  width: 104rpx; height: 104rpx; flex: none; border-radius: var(--r-full);
  background: linear-gradient(135deg, var(--brand-500), var(--indigo-500));
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.avatar.is-vip { box-shadow: 0 0 0 4rpx var(--warn-500); }
.avatar-img { width: 100%; height: 100%; }
.avatar-mark { color: #fff; font-size: 40rpx; font-weight: 800; }
.banner-text { min-width: 0; }
.banner-name-row { display: flex; align-items: center; gap: 12rpx; }
.banner-name {
  font-size: 32rpx; font-weight: 800; color: var(--text-1);
  max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.tag {
  padding: 2rpx 12rpx; border-radius: var(--r-sm); font-size: 18rpx; font-weight: 800;
  color: var(--text-3); background: var(--surface-sunk);
}
.tag.is-bound { color: var(--brand-text); background: var(--st-captured-bg); }
.banner-id { display: block; margin-top: 6rpx; font-size: 20rpx; color: var(--text-4); }
.topup {
  flex: none; padding: 12rpx 24rpx; border-radius: var(--r-full);
  background: linear-gradient(90deg, #fbbf24, #eab308); color: #0f172a;
  font-size: 22rpx; font-weight: 800;
}

/* —— M1 Credits 卡 —— */
.credits {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 24rpx; padding: 26rpx; border-radius: var(--r-lg);
  background: linear-gradient(100deg, rgba(251, 191, 36, 0.16), rgba(249, 115, 22, 0.08));
  border: 2rpx solid rgba(251, 191, 36, 0.45);
}
.credits.is-zero { background: var(--surface-sunk); border-color: var(--border); }
.credits-left { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.credits-icon {
  width: 68rpx; height: 68rpx; flex: none; border-radius: var(--r-md);
  background: rgba(245, 158, 11, 0.18);
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}
.credits-row { display: flex; align-items: center; gap: 14rpx; }
.credits-num { font-size: 24rpx; font-weight: 800; color: var(--text-1); }
.credits-go { font-size: 20rpx; font-weight: 700; color: var(--brand-text); }
.credits-note { display: block; margin-top: 4rpx; font-size: 20rpx; color: var(--text-3); }

/* —— 学习数据 —— */
.stats { margin-top: 24rpx; padding: 26rpx; border-radius: var(--r-lg); }
.stats-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.stats-streak { font-size: 20rpx; color: var(--text-4); }
.stats-grid { display: flex; gap: 16rpx; }
.stat {
  flex: 1; padding: 24rpx; border-radius: var(--r-md); text-align: center;
  background: var(--surface-sunk); border: 2rpx solid var(--border);
}
.stat-label { display: block; font-size: 20rpx; font-weight: 700; color: var(--text-3); }
.stat-num { display: block; margin-top: 6rpx; font-size: 40rpx; font-weight: 800; }
.stat-act { color: var(--ok-600); }
.stat-learn { color: var(--brand-text); }

/* —— 列表 —— */
.group { margin-top: 24rpx; border-radius: var(--r-lg); overflow: hidden; }
.item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 26rpx 28rpx; border-bottom: 2rpx solid var(--border);
}
.item:last-child { border-bottom: none; }
.item-icon {
  width: 60rpx; height: 60rpx; flex: none; border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.ic-green { background: rgba(16, 185, 129, 0.12); }
.ic-amber { background: rgba(245, 158, 11, 0.12); }
.ic-purple { background: rgba(168, 85, 247, 0.12); }
.ic-blue { background: rgba(59, 130, 246, 0.12); }
.ic-indigo { background: rgba(99, 102, 241, 0.12); }
.ic-slate { background: rgba(100, 116, 139, 0.12); }
.ic-rose { background: rgba(244, 63, 94, 0.12); }
.item-text { flex: 1; min-width: 0; }
.item-title { display: block; font-size: 26rpx; font-weight: 800; color: var(--text-1); }
.item-title.is-danger-text { color: var(--danger-500); }
.item-sub { display: block; margin-top: 4rpx; font-size: 20rpx; color: var(--text-3); }
.chev { flex: none; font-size: 32rpx; color: var(--text-4); }

.seg {
  flex: none; display: flex; padding: 4rpx; border-radius: var(--r-full);
  background: var(--surface-sunk); border: 2rpx solid var(--border);
}
.seg-btn {
  padding: 8rpx 18rpx; border-radius: var(--r-full);
  font-size: 20rpx; font-weight: 700; color: var(--text-3);
}
.seg-btn.is-on { background: var(--brand-600); color: #fff; }

/* —— 纯文字尾巴 —— */
.note { padding: 40rpx 0 8rpx; text-align: center; }
.note-line { display: block; font-size: 22rpx; color: var(--text-4); line-height: 1.9; }

.tail { height: 60rpx; }

/* —— 弹层 —— */
.mask {
  position: fixed; inset: 0; z-index: 50; background: rgba(2, 6, 23, 0.6);
  display: flex; align-items: center; justify-content: center; padding: 48rpx;
}
.dialog {
  width: 100%; padding: 36rpx 32rpx; border-radius: var(--r-lg);
  background: var(--surface); border: 2rpx solid var(--border);
}
.dlg-title { display: block; font-size: 30rpx; font-weight: 800; color: var(--text-1); }
.dlg-sub { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--text-3); line-height: 1.6; }
.dlg-err { display: block; margin-top: 16rpx; font-size: 22rpx; color: var(--danger-500); }

.opt {
  margin-top: 20rpx; padding: 24rpx; border-radius: var(--r-md);
  border: 2rpx solid var(--border); background: var(--surface-sunk);
}
.opt.is-on { border-color: var(--brand-600); background: var(--st-captured-bg); }
.opt-title { display: block; font-size: 26rpx; font-weight: 800; color: var(--text-1); }
.opt-sub { display: block; margin-top: 8rpx; font-size: 20rpx; color: var(--text-3); line-height: 1.7; }

.field {
  margin-top: 20rpx; height: 88rpx; padding: 0 24rpx;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  background: var(--surface-sunk); font-size: 26rpx; color: var(--text-1);
}
.ph { color: var(--text-4); }

.dlg-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.btn-ghost {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  font-size: 26rpx; font-weight: 700; color: var(--text-2);
}
.btn-ok {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); background: var(--brand-600); color: #fff;
  font-size: 26rpx; font-weight: 800;
}
