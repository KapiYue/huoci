.license { padding-top: 32rpx; }
.block { padding: 32rpx 28rpx; margin-bottom: 24rpx; }
.block-title { display: block; font-size: 30rpx; font-weight: 800; color: var(--text-1); }
.block-body { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--text-3); line-height: 1.7; }
.kv { display: flex; gap: 20rpx; margin-top: 20rpx; }
.k { flex: none; width: 120rpx; font-size: 24rpx; color: var(--text-4); }
.v { flex: 1; font-size: 24rpx; color: var(--text-2); line-height: 1.6; word-break: break-all; }
.v-link { color: var(--brand-text); font-weight: 700; }
.foot-note { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--text-4); line-height: 1.7; }
