.hc-page { padding-top: 24rpx; }

.head { padding: 8rpx 4rpx 24rpx; }
.head-title { display: block; font-size: 40rpx; font-weight: 800; color: var(--text-1); }
.head-desc { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--text-3); line-height: 1.7; }

.counts { padding: 28rpx; border-radius: var(--r-lg); }
.counts-line { display: block; font-size: 24rpx; font-weight: 700; color: var(--text-2); margin-bottom: 24rpx; }
.joined-row { display: flex; gap: 20rpx; }
.ghost-btn {
  flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  font-size: 26rpx; font-weight: 800; color: var(--brand-text);
}
.ghost-btn.is-danger { color: var(--danger-500); border-color: rgba(244, 63, 94, 0.4); }

.sec { display: block; margin: 36rpx 4rpx 16rpx; }
.word {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  padding: 24rpx 26rpx; margin-bottom: 14rpx; border-radius: var(--r-md);
}
.word-left { flex: 1; min-width: 0; }
.word-term { display: block; font-size: 28rpx; font-weight: 800; color: var(--text-1); }
.word-meaning { display: block; margin-top: 4rpx; font-size: 21rpx; color: var(--text-3); }
.word-note { padding: 16rpx 8rpx; font-size: 20rpx; color: var(--text-4); line-height: 1.7; }

.share-btn {
  margin-top: 24rpx; height: 96rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  background: var(--surface); font-size: 26rpx; font-weight: 800; color: var(--brand-text);
}

/* —— W3 接收 —— */
.share { padding: 40rpx 32rpx; border-radius: var(--r-xl); }
.share-from { display: block; font-size: 22rpx; font-weight: 700; color: var(--warn-600); }
.share-title { display: block; margin-top: 16rpx; font-size: 36rpx; font-weight: 800; color: var(--text-1); }
.share-preview { display: block; margin-top: 12rpx; font-size: 22rpx; color: var(--text-3); }
.share-note { display: block; margin: 20rpx 0 32rpx; font-size: 20rpx; color: var(--text-4); line-height: 1.7; }
.hero-done {
  height: 96rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); background: var(--surface-sunk);
  font-size: 26rpx; font-weight: 700; color: var(--text-3);
}

.tail { height: 60rpx; }
