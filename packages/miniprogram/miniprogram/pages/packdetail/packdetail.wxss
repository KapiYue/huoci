.detail-page { padding-top: calc(env(safe-area-inset-top) + 104rpx); }
.detail-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.back-link { display: flex; align-items: center; gap: 8rpx; color: var(--text-3); font-size: 34rpx; font-weight: 800; }
.back-link text { font-size: 22rpx; }
.top-share { display: flex; align-items: center; gap: 6rpx; padding: 8rpx 18rpx; border-radius: var(--r-full); color: var(--brand-text); background: var(--st-captured-bg); font-size: 24rpx; font-weight: 900; }
.top-share text { font-size: 21rpx; }
.top-share image { width: 28rpx; height: 28rpx; }

.summary-card { padding: 30rpx; border-radius: var(--r-lg); background: var(--surface); }
.head-title { display: block; font-size: 34rpx; font-weight: 900; color: var(--text-1); }
.head-desc { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--text-3); line-height: 1.7; }

.counts-line { display: flex; align-items: center; gap: 12rpx; margin: 20rpx 0 28rpx; font-size: 22rpx; font-weight: 800; color: var(--text-2); }
.activated-count { color: var(--ok-600); }
.unlearned-count { color: var(--text-4); }
.joined-row { display: flex; gap: 20rpx; }
.study-pack-btn {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; gap: 14rpx;
  border-radius: 32rpx; background: linear-gradient(90deg,#9333ea,#4f46e5);
  box-shadow: var(--shadow-btn); font-size: 25rpx; font-weight: 900; color: #fff;
}
.study-pack-btn image { width: 32rpx; height: 32rpx; }
.remove-btn { width: 104rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; border: 2rpx solid #e2e8f0; color: var(--text-3); font-size: 24rpx; font-weight: 800; }

.words-card { margin-top: 28rpx; padding: 30rpx; border-radius: var(--r-lg); background: var(--surface); }
.words-title { margin-bottom: 12rpx; color: var(--text-2); font-size: 22rpx; font-weight: 900; }
.word {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  padding: 20rpx 0; border-bottom: 2rpx solid #f1f5f9;
}
.word:last-child { border-bottom: 0; }
.word-left { flex: 1; min-width: 0; }
.word-term { display: block; font-size: 28rpx; font-weight: 800; color: var(--text-1); }
.word-meaning { display: block; margin-top: 4rpx; font-size: 21rpx; color: var(--text-3); }
.status-badge { flex: none; padding: 3rpx 14rpx; border-radius: 12rpx; border: 2rpx solid transparent; font-size: 20rpx; font-weight: 800; }
.status-activated { color: var(--st-activated-fg); background: var(--st-activated-bg); border-color: var(--st-activated-bd); }
.status-learning { color: var(--brand-text); background: var(--st-captured-bg); border-color: var(--st-captured-bd); }
.status-unlearned { color: var(--text-4); background: #f1f5f9; border-color: #e2e8f0; }

.share-btn {
  margin-top: 24rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  background: var(--surface); font-size: 26rpx; font-weight: 800; color: var(--brand-text);
}
.share-btn image { width: 30rpx; height: 30rpx; }

.mask { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 36rpx; background: rgba(2,6,23,.66); }
.share-dialog { width: 100%; padding: 38rpx 32rpx; border-radius: var(--r-xl); background: var(--surface); border: 2rpx solid var(--border); box-shadow: 0 24rpx 80rpx rgba(15,23,42,.28); }
.share-head { display: flex; align-items: center; justify-content: space-between; }
.share-dialog-title { color: var(--text-1); font-size: 28rpx; font-weight: 900; }
.share-x { padding: 0 6rpx; color: var(--text-4); font-size: 36rpx; }
.share-preview-card { margin-top: 26rpx; padding: 28rpx; border-radius: var(--r-md); background: #faf5ff; border: 2rpx solid var(--border-strong); text-align: center; }
.share-preview-label { display: block; color: var(--text-3); font-size: 21rpx; }
.share-preview-title { display: block; margin-top: 6rpx; color: var(--brand-text); font-size: 30rpx; font-weight: 900; }
.share-preview-count { display: block; margin-top: 3rpx; color: var(--text-2); font-size: 21rpx; }
.share-dialog-note { display: block; margin: 28rpx 0; color: var(--text-3); font-size: 22rpx; line-height: 1.7; }
.wechat-share { width: 100%; height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--r-md); background: var(--ok-600); color: #fff; font-size: 24rpx; font-weight: 900; }

/* —— W3 接收 —— */
.share { padding: 40rpx 32rpx; border-radius: var(--r-xl); }
.share-from { display: block; font-size: 22rpx; font-weight: 700; color: var(--warn-600); }
.share-title { display: block; margin-top: 16rpx; font-size: 36rpx; font-weight: 800; color: var(--text-1); }
.share-preview { display: block; margin-top: 12rpx; font-size: 22rpx; color: var(--text-3); }
.share-note { display: block; margin: 20rpx 0 32rpx; font-size: 20rpx; color: var(--text-4); line-height: 1.7; }
.hero-done {
  height: 96rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); background: var(--surface-sunk);
  font-size: 26rpx; font-weight: 700; color: var(--text-3);
}

.tail { height: 60rpx; }
