<!-- H1 首启 S1–S3。UI 唯一标准：docs/prototype/src/components/OnboardingFlow.tsx -->
<view class="hc-page hc-immersive-page ob {{themeClass}}">
  <view class="dream dream-a"></view>
  <view class="dream dream-b"></view>

  <block wx:if="{{step === 1}}">
    <view class="screen-body">
      <view class="step-row"><text>第 1 步 / 共 3 步</text><text>目标用时 40 秒</text></view>
      <text class="title">你平时在哪里遇到英文最多？</text>
      <text class="sub">多选场景，我们将为你匹配最契合的技术与职场语境</text>

      <view class="scene-grid">
        <button wx:for="{{scenes}}" wx:key="id"
          class="scene {{item.selected ? 'is-on' : ''}}"
          data-id="{{item.id}}" bindtap="toggleScene" hover-class="tap-down"
          role="button" aria-label="{{item.label}}，{{item.desc}}">
          <view class="scene-top">
            <view class="scene-icon"><image class="scene-icon-image" src="{{item.selected ? item.iconOn : item.icon}}" mode="aspectFit" /></view>
            <text class="scene-check" wx:if="{{item.selected}}">✓</text>
          </view>
          <text class="scene-label">{{item.label}}</text>
          <text class="scene-desc">{{item.desc}}</text>
        </button>
      </view>
    </view>

    <view class="bottom-action">
      <view class="primary {{selectedScenes.length === 0 ? 'is-disabled' : ''}}"
        bindtap="goStep2" hover-class="tap-down" role="button" aria-disabled="{{selectedScenes.length === 0}}" aria-label="下一步：40 秒生词初探">
        <text>下一步：40 秒生词初探</text><text class="arrow">→</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 2}}">
    <view class="screen-body word-screen">
      <view class="step-row"><text>第 2 步 / 共 3 步</text><text class="selected-count">已选 {{checkedCount}} 词</text></view>
      <text class="title">哪些词你说不出口？</text>
      <text class="sub">点击勾选平时「认识但张口卡壳」或「意思模棱两可」的生词</text>

      <scroll-view class="word-scroll" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}">
        <view class="word-grid">
          <button wx:for="{{words}}" wx:key="spelling"
            class="word-card {{item.checked ? 'is-on' : ''}}"
            data-spelling="{{item.spelling}}" catchtap="toggleWord" hover-class="tap-down"
            aria-label="{{item.spelling}}，{{item.hint}}，{{item.checked ? '已选' : '未选'}}">
            <view class="word-copy">
              <text class="word-spelling">{{item.spelling}}</text>
              <text class="word-hint">{{item.hint}}</text>
            </view>
            <view class="word-check">{{item.checked ? '✓' : ''}}</view>
          </button>
        </view>
        <view class="word-pad"></view>
      </scroll-view>
    </view>

    <view class="bottom-action">
      <view class="primary" bindtap="finishSelection" hover-class="tap-down" role="button">
        <text>开始我的今日活词计划</text><text class="arrow">→</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="result-screen">
      <view class="result-main">
        <view class="sparkle-mark">✦</view>
        <text class="result-title" wx:if="{{!isHighLevel}}">今天先帮你激活 {{seededCount}} 个词</text>
        <text class="result-title" wx:else>你的底子够了</text>
        <text class="result-sub" wx:if="{{!isHighLevel}}">已根据你的场景定制学习队列。无需生硬背诵，结合真实例句与来源进行激活。</text>
        <text class="result-sub" wx:else>真正该收的，是你在自己的文章里撞见的词。</text>

        <view class="result-card">
          <view class="result-row"><text class="result-label">匹配场景</text><text class="result-value purple">{{sceneLabels || '通用职场语境'}}</text></view>
          <view class="result-row"><text class="result-label">首批播种词汇</text><text class="result-value green">{{seededCount}} 个高频职场词</text></view>
          <view class="result-row no-border"><text class="result-label">活词激活标准</text><text class="result-value">稳定性 ≥ 21 天</text></view>
        </view>
      </view>

      <view class="bottom-action result-action">
        <view wx:if="{{isHighLevel}}" class="primary result-primary" bindtap="goReader" hover-class="tap-down" role="button"><text>去读一篇自己的文章</text><text class="arrow">→</text></view>
        <view wx:else class="primary result-primary" bindtap="startLearning" hover-class="tap-down" role="button"><text>立即进入「今日」开始</text><text class="arrow">→</text></view>
      </view>
    </view>
  </block>

  <view class="ob-tabbar">
    <view class="ob-tab {{item.active ? 'is-on' : ''}}" wx:for="{{previewTabs}}" wx:key="text">
      <image class="ob-tab-icon" src="{{item.icon}}" mode="aspectFit" />
      <text>{{item.text}}</text>
    </view>
  </view>
</view>
