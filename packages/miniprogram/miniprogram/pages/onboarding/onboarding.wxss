.ob { position: relative; display: flex; flex-direction: column; width: 100%; height: 100vh; min-height: 0; padding: calc(env(safe-area-inset-top) + 162rpx) 40rpx calc(env(safe-area-inset-bottom) + 108rpx) !important; overflow: hidden; }
.dream { position: absolute; border-radius: 999rpx; pointer-events: none; filter: blur(2rpx); }
.dream-a { width: 260rpx; height: 260rpx; right: -130rpx; top: 60rpx; background: rgba(216, 180, 254, .17); }
.dream-b { width: 220rpx; height: 220rpx; left: -130rpx; bottom: 180rpx; background: rgba(165, 180, 252, .14); }

.screen-body { position: relative; z-index: 1; width: 100%; padding-top: 16rpx; }
.word-screen { display: flex; flex-direction: column; min-height: 0; }
.step-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; color: var(--brand-500); font-size: 22rpx; font-weight: 700; }
.selected-count { display: block; color: var(--ok-500); }
.title { display: block; color: var(--text-1); font-size: 44rpx; line-height: 1.25; font-weight: 800; }
.sub { display: block; margin-top: 8rpx; color: var(--text-3); font-size: 22rpx; line-height: 1.5; }

.scene-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 40rpx; }
.scene { position: relative; width: calc((100% - 20rpx) / 2); height: 192rpx; padding: 28rpx; border: 2rpx solid rgba(243, 232, 255, .95); border-radius: 32rpx; background: rgba(255, 255, 255, .9); box-shadow: 0 2rpx 6rpx rgba(76, 29, 149, .08); transition: transform .16s, border-color .16s, background .16s; }
.scene.is-on { border-color: #c084fc; background: rgba(243, 232, 255, .92); }
.scene-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.scene-icon { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: #faf5ff; }
.scene-icon-image { width: 32rpx; height: 32rpx; }
.scene.is-on .scene-icon { background: var(--brand-500); color: #fff; }
.scene-check { color: var(--brand-500); font-size: 26rpx; font-weight: 800; }
.scene-label { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--text-2); font-size: 24rpx; font-weight: 800; line-height: 1.25; }
.scene-desc { display: block; margin-top: 7rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--text-4); font-size: 20rpx; line-height: 1.25; }

.word-scroll { flex: none; align-self: stretch; box-sizing: border-box; width: 100%; min-width: 0; height: 680rpx; margin-top: 32rpx; overflow: hidden; }
.word-grid { box-sizing: border-box; width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.word-card { box-sizing: border-box; width: 100%; min-width: 0; height: 94rpx; padding: 20rpx; display: flex; align-items: center; justify-content: space-between; gap: 10rpx; border: 2rpx solid #f1f5f9; border-radius: 24rpx; background: rgba(255, 255, 255, .94); box-shadow: 0 2rpx 4rpx rgba(15, 23, 42, .04); transition: transform .14s, background .14s, border-color .14s; }
.word-card.is-on { border-color: #c084fc; background: rgba(243, 232, 255, .96); }
.word-copy { min-width: 0; flex: 1; }
.word-spelling { display: block; overflow: hidden; text-overflow: ellipsis; color: var(--text-2); font-size: 22rpx; line-height: 1.2; font-weight: 800; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
.word-hint { display: block; margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-4); font-size: 18rpx; line-height: 1.2; }
.word-check { width: 30rpx; height: 30rpx; flex: 0 0 30rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #cbd5e1; border-radius: 9rpx; color: #fff; font-size: 19rpx; font-weight: 900; }
.word-card.is-on .word-check { border-color: var(--brand-600); background: var(--brand-600); }
.word-pad { height: 24rpx; }

.bottom-action { position: absolute; z-index: 3; left: 40rpx; width: 670rpx; bottom: calc(env(safe-area-inset-bottom) + 148rpx); }
.primary { width: 670rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; border-radius: 32rpx; background: linear-gradient(90deg, #9333ea, #4f46e5); color: #fff; font-size: 28rpx; font-weight: 700; box-shadow: 0 13rpx 30rpx rgba(147, 51, 234, .25); transition: transform .14s, opacity .14s; }
.primary.is-disabled { opacity: .5; }
.arrow { font-size: 30rpx; line-height: 1; }
.tap-down { transform: scale(.985); opacity: .9; }

.result-screen { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; }
.result-main { flex: 1; padding-top: 56rpx; text-align: center; }
.sparkle-mark { width: 88rpx; height: 88rpx; margin: 0 auto 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; border: 2rpx solid rgba(168, 85, 247, .3); background: linear-gradient(135deg, rgba(168,85,247,.18), rgba(236,72,153,.16)); color: var(--brand-500); font-size: 52rpx; }
.result-title { display: block; color: var(--text-1); font-size: 44rpx; line-height: 1.3; font-weight: 900; }
.result-sub { display: block; max-width: 590rpx; margin: 16rpx auto 0; color: var(--text-3); font-size: 22rpx; line-height: 1.55; }
.result-card { margin-top: 46rpx; padding: 12rpx 28rpx; text-align: left; border: 2rpx solid var(--border); border-radius: 30rpx; background: rgba(255,255,255,.9); box-shadow: var(--shadow-card); }
.result-row { min-height: 78rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 2rpx solid #f1f5f9; }
.result-row.no-border { border-bottom: 0; }
.result-label { color: var(--text-4); font-size: 21rpx; }
.result-value { max-width: 62%; color: var(--brand-500); font-size: 22rpx; font-weight: 800; text-align: right; }
.result-value.green { color: var(--ok-500); }
.result-value.purple { color: var(--brand-500); }
.result-action { padding-top: 28rpx; }
.result-primary { height: 100rpx; background: linear-gradient(90deg, #9333ea, #4f46e5 55%, #ec4899); font-size: 29rpx; font-weight: 800; }

.ob-tabbar { position: absolute; z-index: 4; left: 0; right: 0; bottom: 0; height: calc(env(safe-area-inset-bottom) + 108rpx); padding-bottom: env(safe-area-inset-bottom); display: flex; align-items: center; border-top: 2rpx solid var(--border); background: rgba(255, 255, 255, .96); }
.ob-tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: var(--text-3); font-size: 19rpx; font-weight: 700; }
.ob-tab.is-on { color: var(--brand-700); font-weight: 900; }
.ob-tab-icon { width: 56rpx; height: 56rpx; }

@media (prefers-color-scheme: dark) {
  .scene, .word-card, .result-card { background: rgba(15,23,42,.82); border-color: rgba(71,85,105,.45); }
  .scene.is-on, .word-card.is-on { background: rgba(88,28,135,.55); border-color: rgba(192,132,252,.85); }
  .scene-icon { background: rgba(30,41,59,.9); }
  .result-row { border-color: rgba(51,65,85,.7); }
}
