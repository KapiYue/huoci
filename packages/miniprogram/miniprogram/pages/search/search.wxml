<!-- ④ 查词。`design.md` §5.4 S7 -->
<view class="hc-page hc-immersive-page search {{themeClass}}">

  <view class="search-head">
    <text class="search-title">查词 · 精准捕捉</text>
    <text class="search-sub">无需登录，输入英文单词即可查看释义</text>
  </view>

  <view class="bar">
    <image class="bar-icon" src="/assets/ui/tab-search-on.svg" mode="aspectFit" />
    <input
      class="bar-input"
      value="{{input}}"
      bindinput="onInput"
      bindconfirm="onConfirm"
      bindfocus="onFocus"
      confirm-type="search"
      cursor-spacing="24"
      placeholder="输入英文单词，如 paradigm, benchmark..."
      placeholder-class="ph"
    />
    <text class="bar-clear" wx:if="{{input}}" bindtap="clear">✕</text>
  </view>

  <!-- 空态。`[09-03]` 按原型补一排高频场景词，省得用户对着空框想不出查什么 -->
  <view class="hint" wx:if="{{phase === 'idle'}}">
    <text class="chips-title">试试这些高频场景词：</text>
    <view class="chips">
      <view class="chip hc-mono" wx:for="{{samples}}" wx:key="*this" data-word="{{item}}" bindtap="useSample">{{item}}</view>
    </view>
    <view class="reader-entry" bindtap="openReader">阅读英文文章并点词查看释义 →</view>
  </view>

  <view class="hint" wx:elif="{{phase === 'loading'}}">
    <text class="hint-title">查询中…</text>
  </view>

  <!-- 无结果态 -->
  <view class="hint" wx:elif="{{phase === 'miss'}}">
    <text class="hint-title">没查到这个词</text>
    <text class="hint-sub">确认一下拼写。词组和缩写暂时查不了。</text>
  </view>

  <!-- 网络失败态 -->
  <view class="hint" wx:elif="{{phase === 'error'}}">
    <text class="hint-title">{{error}}</text>
    <text class="hint-sub" bindtap="onConfirm">点这里重试</text>
  </view>

  <!-- 结果 -->
  <view class="card hc-card" wx:elif="{{result}}">
    <view class="card-head">
      <text class="term">{{result.term}}</text>
      <text class="speak {{playing ? 'is-on' : ''}}" wx:if="{{result.audioUrl}}" bindtap="play">🔊</text>
    </view>
    <text class="phonetic hc-mono" wx:if="{{result.phonetic}}">{{result.phonetic}}</text>

    <view class="divider"></view>
    <text class="result-label">释义</text>

    <view class="part" wx:for="{{result.parts}}" wx:key="partOfSpeech">
      <text class="pos">{{item.partOfSpeech}}</text>
      <text class="pos-meaning">{{item.meaning}}</text>
    </view>

    <view class="example" wx:if="{{result.exampleEnglish}}">
      <text class="result-label example-label">例句 · 查词抓取</text>
      <text class="example-en">“{{result.exampleEnglish}}”</text>
      <text class="example-zh" wx:if="{{result.exampleChinese}}">{{result.exampleChinese}}</text>
    </view>

    <view class="foot">
      <view class="added" wx:if="{{saved}}">✓ 已在我的生词库中</view>
      <button class="hc-primary-btn" wx:else bindtap="addWord" loading="{{saving}}">＋ 加入我的生词</button>
    </view>
  </view>

  <view class="saved-toast" wx:if="{{savedNotice}}">✦ 成功收录！明天将进入今日复习队列</view>
</view>
