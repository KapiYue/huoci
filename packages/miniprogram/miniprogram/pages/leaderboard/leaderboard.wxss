.hc-page { display: flex; flex-direction: column; height: 100vh; padding-top: calc(env(safe-area-inset-top) + 80rpx); padding-bottom: 0; }

.nav { position: relative; height: 88rpx; flex: none; display: flex; align-items: center; justify-content: space-between; margin: 0 -32rpx 20rpx; padding: 0 32rpx; border-bottom: 2rpx solid #eef2f7; background: rgba(255,255,255,.96); }
.nav-back { z-index: 1; min-width: 120rpx; height: 88rpx; display: flex; align-items: center; gap: 4rpx; color: var(--text-2); font-size: 22rpx; font-weight: 800; }
.nav-arrow { font-size: 54rpx; line-height: 1; font-weight: 300; color: var(--text-1); transform: translateY(-2rpx); }
.nav-title { position: absolute; left: 150rpx; right: 150rpx; text-align: center; font-size: 25rpx; font-weight: 900; color: var(--text-1); }
.nav-space { width: 120rpx; }

.hidden-box { padding: 48rpx 32rpx; border-radius: var(--r-lg); text-align: center; }
.hidden-title { display: block; font-size: 30rpx; font-weight: 800; color: var(--text-1); }
.hidden-sub { display: block; margin-top: 14rpx; font-size: 22rpx; color: var(--text-3); line-height: 1.8; }

/* —— 周切换 —— */
.seg {
  align-self: flex-end; display: flex; padding: 4rpx; margin-bottom: 20rpx;
  border-radius: var(--r-full); background: var(--surface-sunk); border: 2rpx solid var(--border);
}
.seg-btn { padding: 10rpx 26rpx; border-radius: var(--r-full); font-size: 22rpx; font-weight: 700; color: var(--text-3); }
.seg-btn.is-on { background: var(--brand-600); color: #fff; }
.measure-row { display: flex; align-items: center; justify-content: space-between; margin: 0 4rpx 18rpx; color: var(--text-3); font-size: 20rpx; }
.privacy-link { color: var(--brand-600); font-size: 19rpx; }

/* —— 榜单 —— */
.list { flex: 1; min-height: 0; }
.row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 22rpx 26rpx; margin-bottom: 14rpx; border-radius: var(--r-md);
}
.row.is-me { border-color: var(--brand-600); background: var(--st-captured-bg); }
.row-rank { width: 48rpx; flex: none; text-align: center; font-size: 26rpx; font-weight: 800; color: var(--text-3); }
.row-avatar {
  width: 68rpx; height: 68rpx; flex: none; border-radius: var(--r-full);
  background: linear-gradient(45deg, #c084fc, #f472b6 52%, #a5b4fc);
  color: #fff; font-size: 26rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; padding: 4rpx;
}
.row-avatar image { width: 100%; height: 100%; border-radius: 50%; background: #ede9fe; }
.row-avatar.is-me { background: linear-gradient(135deg, var(--ok-500), var(--cyan-500)); }
.row-avatar.big { width: 100rpx; height: 100rpx; font-size: 34rpx; }
.row-text { flex: 1; min-width: 0; }
.row-name { display: block; font-size: 26rpx; font-weight: 800; color: var(--text-1); }
.row-num { display: block; margin-top: 2rpx; font-size: 20rpx; color: var(--text-3); }
.pk-btn {
  flex: none; padding: 10rpx 22rpx; border-radius: var(--r-full); display: flex; align-items: center; gap: 7rpx;
  background: var(--brand-600); color: #fff; font-size: 22rpx; font-weight: 800;
}
.pk-btn image { width: 24rpx; height: 24rpx; }

/* —— 我的固定条 —— */
.mine {
  display: flex; align-items: center; gap: 20rpx;
  padding: 22rpx 26rpx;
  margin: 18rpx 0 calc(env(safe-area-inset-bottom) + 22rpx); padding: 22rpx 24rpx;
  border: 2rpx solid var(--border-strong); border-radius: var(--r-md); background: var(--st-captured-bg);
  box-shadow: var(--shadow-xs);
}
.mine-rank { flex: none; color: var(--brand-text); font-size: 22rpx; font-weight: 900; }
.mine-status { flex: none; color: var(--brand-text); font-size: 21rpx; font-weight: 800; }

/* —— L2 / L4 卡片 —— */
.card { padding: 36rpx 32rpx; border-radius: var(--r-xl); }
.card-title { display: block; font-size: 32rpx; font-weight: 800; color: var(--text-1); text-align: center; }
.card-sub { display: block; margin: 24rpx 0; font-size: 22rpx; color: var(--text-3); text-align: center; line-height: 1.7; }
.card-note { display: block; margin-top: 20rpx; font-size: 20rpx; color: var(--text-4); text-align: center; }
.vs { display: flex; align-items: center; justify-content: center; gap: 40rpx; margin: 32rpx 0; }
.vs-side { text-align: center; }
.vs-name { display: block; margin-top: 10rpx; font-size: 22rpx; font-weight: 700; color: var(--text-2); }
.vs-mark { font-size: 24rpx; font-weight: 900; color: var(--brand-600); }

.ghost-btn {
  margin-top: 20rpx; height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  font-size: 26rpx; font-weight: 800; color: var(--brand-text);
}
.ghost-btn.small { flex: none; margin: 0; height: 60rpx; padding: 0 22rpx; font-size: 20rpx; }
.back { margin-top: 28rpx; text-align: center; font-size: 24rpx; font-weight: 700; color: var(--text-3); }
.invite-main { flex: 1; padding: 52rpx 8rpx 20rpx; text-align: center; }
.swords-hero { width: 128rpx; height: 128rpx; margin: 0 auto 34rpx; border-radius: 48rpx; display: flex; align-items: center; justify-content: center; background: #f3e8ff; box-shadow: var(--shadow-sm); }
.swords-hero image { width: 64rpx; height: 64rpx; }
.invite-main .card-sub { margin: 10rpx 0 32rpx; }
.match-card { padding: 28rpx; border: 2rpx solid var(--border); border-radius: var(--r-xl); background: rgba(250,245,255,.82); text-align: left; }
.match-label { display: block; color: var(--text-2); font-size: 22rpx; font-weight: 900; }
.match-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.match-user { display: flex; align-items: center; gap: 14rpx; color: var(--text-1); font-size: 22rpx; font-weight: 800; }
.match-scope { display: block; margin-top: 18rpx; color: var(--text-4); font-size: 20rpx; }
.invite-main .card-note { margin-top: 28rpx; color: var(--warn-600); font-size: 22rpx; font-weight: 700; }
.invite-actions { padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx); }
.invite-actions .hc-primary-btn { width: 100%; height: 88rpx; border-radius: 28rpx; font-size: 24rpx; }
.share-invite { width: 100%; height: 80rpx; margin-top: 14rpx; border: 2rpx solid var(--border-strong); border-radius: 28rpx; background: var(--surface); color: var(--brand-text); font-size: 23rpx; font-weight: 800; }

/* —— L3 对战 —— */
.scorebar { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx; }
.score { font-size: 22rpx; font-weight: 800; color: var(--text-3); }
.qidx { font-size: 22rpx; color: var(--text-3); }
.timer {
  min-width: 82rpx; text-align: center; padding: 7rpx 14rpx;
  border-radius: var(--r-full); background: rgba(244,63,94,.12);
  font-size: 22rpx; font-weight: 900; color: var(--danger-500);
}
.timer.is-hot { background: rgba(244, 63, 94, 0.15); color: var(--danger-500); }
.qcard { margin-top: 32rpx; padding: 46rpx 32rpx; border-radius: var(--r-xl); text-align: center; background: var(--surface); }
.qhint { display: block; font-size: 20rpx; font-weight: 800; color: var(--text-4); }
.qterm { display: block; margin-top: 10rpx; font-size: 44rpx; font-weight: 900; color: var(--text-1); }
.opts { margin-top: 28rpx; display: flex; flex-direction: column; gap: 18rpx; }
.opt { display: flex; align-items: center; padding: 25rpx 28rpx; border-radius: var(--r-md); font-size: 23rpx; font-weight: 800; color: var(--text-1); background: var(--surface); }
.opt-letter { width: 44rpx; flex: none; color: var(--text-4); }
.opt.is-right { border-color: var(--ok-500); background: var(--st-activated-bg); color: var(--st-activated-fg); }
.opt.is-wrong { border-color: var(--danger-500); background: rgba(244, 63, 94, 0.12); color: var(--danger-500); }
.battle-note { margin-top: auto; padding-bottom: calc(env(safe-area-inset-bottom) + 34rpx); text-align: center; font-size: 20rpx; color: var(--text-4); }

/* —— L4 结果 —— */
.result-summary { padding-top: 26rpx; text-align: center; }
.result-title { display: block; font-size: 38rpx; font-weight: 900; color: var(--text-1); }
.result-lines { margin-top: 8rpx; display: flex; align-items: center; justify-content: center; }
.result-line { font-size: 21rpx; font-weight: 700; color: var(--text-3); }
.result-sep { margin: 0 14rpx; color: var(--text-4); }
.review-card { margin-top: 28rpx; padding: 24rpx 28rpx; border-radius: var(--r-xl); background: var(--surface); }
.review-head { display: flex; align-items: center; justify-content: space-between; }
.review-toggle { font-size: 22rpx; font-weight: 800; color: var(--brand-text); }
.review { display: flex; align-items: center; justify-content: space-between; min-height: 62rpx; border-top: 2rpx solid #f1f5f9; }
.review:first-child { margin-top: 18rpx; }
.review-term { font-size: 22rpx; font-weight: 800; color: var(--text-1); }
.review-answer { font-size: 21rpx; color: var(--text-3); }
.review-line { display: block; margin-top: 6rpx; font-size: 22rpx; font-weight: 700; }
.review-line.is-ok { color: var(--ok-600); }
.review-line.is-bad { color: var(--danger-500); }
.review-mine { display: block; margin-top: 4rpx; font-size: 20rpx; color: var(--text-4); }
.result-actions { margin-top: auto; padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx); }
.poster-btn { height: 88rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; border-radius: 28rpx; background: linear-gradient(90deg,#a000ff,#5138f2); color: #fff; font-size: 23rpx; font-weight: 900; box-shadow: var(--shadow-btn); }
.result-secondary { display: flex; gap: 16rpx; margin-top: 14rpx; }
.result-secondary .ghost-btn { flex: 1; margin: 0; height: 80rpx; font-size: 22rpx; }
.result-secondary .neutral { color: var(--text-2); border-color: #e2e8f0; }

.empty { padding: 48rpx 32rpx; border-radius: var(--r-md); text-align: center; }
.empty-title { display: block; font-size: 28rpx; font-weight: 800; color: var(--text-2); }
.empty-sub { display: block; margin-top: 12rpx; font-size: 21rpx; color: var(--text-3); line-height: 1.7; }
.tail { height: 40rpx; }

/* —— 弹层 —— */
.mask {
  position: fixed; inset: 0; z-index: 50; background: rgba(2, 6, 23, 0.6);
  display: flex; align-items: center; justify-content: center; padding: 48rpx;
}
.dialog {
  width: 100%; padding: 36rpx 32rpx; border-radius: var(--r-lg);
  background: var(--surface); border: 2rpx solid var(--border);
}
.dlg-title { display: block; font-size: 30rpx; font-weight: 800; color: var(--text-1); }
.dlg-sub { display: block; margin-top: 16rpx; font-size: 22rpx; color: var(--text-3); line-height: 1.8; }
.dlg-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.btn-ghost {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  font-size: 26rpx; font-weight: 700; color: var(--text-2);
}
.btn-ok {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); background: var(--brand-600); color: #fff;
  font-size: 26rpx; font-weight: 800;
}
.poster-dialog { max-width: 600rpx; padding: 38rpx 34rpx 32rpx; border-radius: 42rpx; }
.poster-head { display: flex; align-items: center; justify-content: space-between; }
.poster-x { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; color: var(--text-4); font-size: 34rpx; }
.poster-preview { margin-top: 24rpx; padding: 28rpx 20rpx 22rpx; border-radius: 28rpx; background: linear-gradient(135deg,#9333ea,#5b35f5); color: #fff; text-align: center; box-shadow: 0 14rpx 36rpx rgba(126,34,206,.26); }
.poster-brand,.poster-title,.poster-streak,.poster-tip { display: block; }
.poster-brand { font-size: 18rpx; opacity: .72; }
.poster-title { margin-top: 22rpx; font-size: 36rpx; font-weight: 900; }
.poster-streak { margin-top: 8rpx; font-size: 20rpx; opacity: .9; }
.qr-box { width: 110rpx; height: 110rpx; margin: 24rpx auto 8rpx; padding: 12rpx; border-radius: 20rpx; background: #fff; }
.qr-box image { width: 100%; height: 100%; }
.poster-tip { font-size: 17rpx; opacity: .7; }
.poster-save { width: 100%; height: 74rpx; margin-top: 24rpx; border-radius: 24rpx; background: linear-gradient(90deg,#9333ea,#a000ff); color: #fff; font-size: 22rpx; font-weight: 900; }
.poster-canvas-export { position: fixed; left: -9999rpx; top: 0; width: 532rpx; height: 420rpx; }
