<!-- 排行榜与好友 PK（L1–L4）。还原对象：`docs/prototype/src/components/LeaderboardModal.tsx`。
     度量单位是**本周新激活的活词数**，不是打卡天数 / 做题量 / 学习时长。
     不显示：段位 · 头衔 · 连胜火苗 · 学习时长 —— 排名是事实，头衔是身份。 -->
<view class="hc-page {{themeClass}}">

  <view class="nav">
    <view class="nav-back" bindtap="backNav"><text class="nav-arrow">‹</text><text wx:if="{{view !== 'list'}}">榜单</text></view>
    <text class="nav-title">{{navTitle}}</text>
    <view class="nav-space"></view>
  </view>

  <!-- 关掉排行榜的人：自己不上榜，也不看别人的榜 -->
  <view class="hidden-box hc-card" wx:if="{{hidden}}">
    <text class="hidden-title">你关掉了排行榜</text>
    <text class="hidden-sub">在「我的 → 不参与排行榜」里可以打开。关着的时候你不上榜，也不看别人的榜。</text>
  </view>

  <block wx:else>

    <!-- L1 · 榜单 -->
    <block wx:if="{{view === 'list'}}">
      <view class="seg">
        <view class="seg-btn {{period === 'thisWeek' ? 'is-on' : ''}}" data-v="thisWeek" bindtap="switchPeriod">本周</view>
        <view class="seg-btn {{period === 'lastWeek' ? 'is-on' : ''}}" data-v="lastWeek" bindtap="switchPeriod">上周</view>
      </view>

      <view class="measure-row">
        <text>度量单位：本周新激活的活词数</text>
        <text class="privacy-link" bindtap="showPrivacy">隐私说明</text>
      </view>

      <scroll-view class="list" scroll-y>
        <view class="row hc-card {{item.isMe ? 'is-me' : ''}}" wx:for="{{rows}}" wx:key="id">
          <text class="row-rank hc-mono">{{item.rank}}</text>
          <view class="row-avatar"><image src="/assets/ui/avatar.svg" mode="aspectFit" /></view>
          <view class="row-text">
            <text class="row-name">{{item.displayName}}</text>
            <text class="row-num">本周激活 {{item.activatedThisWeek}} 个活词</text>
          </view>
          <view class="pk-btn" wx:if="{{!item.isMe}}" data-id="{{item.id}}" data-name="{{item.displayName}}" bindtap="invite"><image src="/assets/ui/icon-swords-white.svg" mode="aspectFit" /><text>PK</text></view>
        </view>

        <view class="empty hc-card" wx:if="{{rows.length <= 1}}">
          <text class="empty-title">榜上还只有你</text>
          <text class="empty-sub">把小程序转发给一个同事，你们下周就能比一比谁激活的活词多。</text>
          <button class="ghost-btn" open-type="share">邀请微信好友一起</button>
        </view>
        <view class="tail"></view>
      </scroll-view>

      <!-- 我的名次固定在底部，即使已经在榜内 -->
      <view class="mine">
        <text class="mine-rank hc-mono">我 · {{mine.rank}}</text>
        <view class="row-avatar is-me"><image src="/assets/ui/avatar.svg" mode="aspectFit" /></view>
        <view class="row-text">
          <text class="row-name">{{mine.displayName}}</text>
          <text class="row-num">本周激活 {{mine.activatedThisWeek}} 个活词</text>
        </view>
        <text class="mine-status">保持领先</text>
      </view>
    </block>

    <!-- L2 · 发起 PK -->
    <block wx:elif="{{view === 'invite'}}">
      <view class="invite-main">
        <view class="swords-hero"><image src="/assets/ui/icon-swords.svg" mode="aspectFit" /></view>
        <text class="card-title">与 {{opponent.displayName}} 进行词汇 PK</text>
        <text class="card-sub">10 道四选一客观词义题 · 每题 10 秒</text>

        <view class="match-card">
          <text class="match-label">对战卡片预览</text>
          <view class="match-row">
            <view class="match-user"><view class="row-avatar"><image src="/assets/ui/avatar.svg" mode="aspectFit" /></view><text>{{mine.displayName}}</text></view>
            <text class="vs-mark">VS</text>
            <view class="match-user"><view class="row-avatar"><image src="/assets/ui/avatar.svg" mode="aspectFit" /></view><text>{{opponent.displayName}}</text></view>
          </view>
          <text class="match-scope">出题范围：优先挑选双方都学过的业务词表</text>
        </view>
        <text class="card-note">等待对方应战 · 24 小时后失效</text>
      </view>
      <view class="invite-actions">
        <button class="hc-primary-btn" bindtap="startBattle">立刻开始模拟挑战</button>
        <!-- 分享必须用户主动点，**不自动弹转发、不做「分享后解锁」** -->
        <button class="share-invite" open-type="share">转发给微信好友</button>
      </view>
    </block>

    <!-- L3 · 对战 -->
    <block wx:elif="{{view === 'battle'}}">
      <view class="scorebar">
        <text class="score">你 {{myScore}} － {{oppScore}} {{opponent.displayName}}</text>
        <view class="timer {{seconds <= 3 ? 'is-hot' : ''}}">◷ <text>{{secondsText}}</text></view>
      </view>

      <view class="qcard hc-card">
        <text class="qhint">请选出正确词义</text>
        <text class="qterm">{{question.term}}</text>
      </view>

      <view class="opts">
        <view class="opt hc-card {{item.cls}}" wx:for="{{options}}" wx:key="idx"
              data-i="{{item.idx}}" bindtap="answer"><text class="opt-letter">{{item.label}}</text><text>{{item.text}}</text></view>
      </view>
      <text class="battle-note">每题 10 秒倒计时，超时自动判错</text>
    </block>

    <!-- L4 · 结果 -->
    <block wx:else>
      <view class="result-summary">
        <text class="result-title">{{resultTitle}}</text>
        <view class="result-lines">
          <text class="result-line">你 {{myScore}}/{{total}} · {{mySeconds}}s</text>
          <text class="result-sep">｜</text>
          <text class="result-line">{{opponent.displayName}} {{oppScore}}/{{total}} · {{oppSeconds}}s</text>
        </view>
      </view>

      <view class="review-card hc-card">
        <view class="review-head" bindtap="toggleReview">
          <text class="hc-section-title">逐题对照（{{total}} 题）</text>
          <text class="review-toggle">{{showReview ? '⌃' : '⌄'}}</text>
        </view>
        <block wx:if="{{showReview}}">
          <view class="review" wx:for="{{review}}" wx:key="term">
            <text class="review-term">{{item.term}}</text>
            <text class="review-answer">{{item.correct}}</text>
          </view>
        </block>
      </view>

      <view class="result-actions">
        <view class="poster-btn" bindtap="openPoster"><text>▧</text><text>生成成果海报</text></view>
        <view class="result-secondary">
          <view class="ghost-btn" bindtap="startBattle">再来一局</view>
          <view class="ghost-btn neutral" bindtap="backToList">回排行榜</view>
        </view>
      </view>
    </block>

  </block>

  <!-- 首次进入的一次性告知。隐私要求，不是可选交互 -->
  <view class="mask" wx:if="{{notice}}" catchtouchmove="noop">
    <view class="dialog" catchtap="noop">
      <text class="dlg-title">上榜会展示什么</text>
      <text class="dlg-sub">榜单会把你的昵称和头像首字展示给所有用过这个小程序的人，以及你本周新激活的活词数。不展示你的具体词、学习时长和任何联系方式。</text>
      <text class="dlg-sub">不想上榜的话，「我的 → 不参与排行榜」随时可以关，关掉后你不上榜，也不看别人的榜。</text>
      <view class="dlg-actions">
        <view class="btn-ghost" bindtap="declineBoard">先不参与</view>
        <button class="btn-ok" bindtap="acceptBoard">知道了</button>
      </view>
    </view>
  </view>

  <!-- 成果海报。canvas 生成，用户自己保存 / 转发，不自动弹 -->
  <view class="mask" wx:if="{{poster}}" bindtap="closePoster" catchtouchmove="noop">
    <view class="dialog poster-dialog" catchtap="noop">
      <view class="poster-head"><text class="dlg-title">活词学习成果</text><text class="poster-x" bindtap="closePoster">×</text></view>
      <view class="poster-preview">
        <text class="poster-brand">活词 · 真实原句驱动</text>
        <text class="poster-title">本周激活 37 个活词</text>
        <text class="poster-streak">连续学习 6 天 · 坚持不懈</text>
        <view class="qr-box"><image src="/assets/ui/icon-qr.svg" mode="aspectFit" /></view>
        <text class="poster-tip">微信扫码体验活词</text>
      </view>
      <button class="poster-save" bindtap="savePoster">保存图片到手机</button>
      <canvas class="poster-canvas-export" type="2d" id="poster"></canvas>
    </view>
  </view>

</view>
