<!-- ③ 我的生词。还原对象：`docs/prototype/src/components/WordsTab.tsx`。
     capture 词的卡片信息明显比底座词丰富 —— 这个差异是**刻意**的（§5.1）。 -->
<view class="hc-page hc-immersive-page words {{themeClass}}">

  <view class="head">
    <view>
      <text class="title">我的生词</text>
      <text class="total">总收录 <text class="hc-mono strong-purple">{{total}}</text> 词 · 活词 <text class="hc-mono strong-green">{{activatedTotal}}</text></text>
    </view>
    <view class="context-badge">✦ 语境抓取驱动</view>
  </view>

  <view class="searchbar">
    <text class="searchbar-icon">🔍</text>
    <input class="searchbar-input" value="{{query}}" bindinput="onSearch"
           placeholder="搜索已收录的英文或中文释义..." placeholder-class="ph" />
    <text class="searchbar-clear" wx:if="{{query}}" bindtap="clearSearch">✕</text>
  </view>

  <view class="tabs">
    <view
      wx:for="{{filters}}"
      wx:key="id"
      class="tab {{filter === item.id ? 'is-on' : ''}}"
      data-id="{{item.id}}"
      bindtap="switchFilter"
    >{{item.label}}</view>
  </view>

  <view class="offline" wx:if="{{stale}}">当前离线，展示的是上次的数据</view>

  <view class="empty hc-card" wx:if="{{loading && !ready}}">
    <text class="empty-title">正在加载你的生词…</text>
  </view>

  <view class="empty hc-card" wx:elif="{{error && !ready}}">
    <text class="empty-title">生词没有加载成功</text>
    <text class="empty-sub">{{error}}</text>
    <view class="empty-btn" bindtap="retryLoad">重新加载</view>
  </view>

  <!-- 空态：引导指向阅读器，**不是**「装插件」 -->
  <block wx:if="{{ready && view.length === 0}}">
    <view class="empty hc-card" wx:if="{{query}}">
      <text class="empty-title">没有找到匹配的词汇</text>
      <text class="empty-sub">往下翻加载更多，或者去「查词」直接搜这个词。</text>
      <text class="empty-alt" bindtap="openSearch">去查词 →</text>
    </view>
    <view class="empty hc-card" wx:elif="{{filter === 'all' || filter === 'recent'}}">
      <text class="empty-title">你的生词本还是空的</text>
      <text class="empty-sub">贴一篇你自己在读的英文，点词就能连原句和来源一起收进来。</text>
      <view class="empty-btn" bindtap="openReader">读一篇文章</view>
      <text class="empty-alt" bindtap="openSearch">或者去查一个词 →</text>
    </view>
    <view class="empty hc-card" wx:elif="{{filter === 'due'}}">
      <text class="empty-title">今天没有到期的词</text>
      <text class="empty-sub">复习是按记忆曲线排的，没到期就是不用学。明天再来。</text>
    </view>
    <view class="empty hc-card" wx:else>
      <text class="empty-title">还没有活词</text>
      <text class="empty-sub">一个词要连着记住、间隔撑过 21 天才算激活。最快也要一个月，慢慢来。</text>
    </view>
  </block>

  <view class="row hc-card {{item.isBase ? 'is-base' : ''}}" wx:for="{{view}}" wx:key="wordId"
        data-id="{{item.wordId}}" bindtap="openDetail">
    <view class="row-top">
      <text class="term">{{item.term}}</text>
      <text class="phonetic hc-mono" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
      <view class="speaker {{playingId === item.wordId ? 'is-on' : ''}}"
            data-id="{{item.wordId}}" data-url="{{item.audioUrl}}" catchtap="playAudio"><image class="speaker-icon" src="/assets/ui/icon-volume.svg" mode="aspectFit" /></view>
      <view class="grow"></view>
      <view class="hc-badge st-{{item.status}}">{{item.statusBadge}} {{item.statusLabel}}</view>
    </view>

    <text class="meaning">{{item.meaning}}</text>

    <!-- 非首启词第三行把原句摘要与来源放在同一条独特的紫色来源带中。 -->
    <view class="context-line" wx:if="{{!item.isBase}}">
      <text class="context">“{{item.contextSentence || '真实场景收录'}}”</text>
      <text class="source">{{item.contextSource}}</text>
    </view>
    <text class="base-source" wx:else>{{item.contextSource}}</text>
  </view>

  <view class="more" wx:if="{{view.length > 0}}">
    <text wx:if="{{loading}}">加载中…</text>
    <text wx:elif="{{hasMore}}">上拉加载更多</text>
    <text wx:else>没有更多了</text>
  </view>

  <view class="tail"></view>
</view>

<!-- 词详情弹窗：首启词是精简版，场景词额外展示真实原句与来源。 -->
<view class="mask" wx:if="{{detail}}" bindtap="closeDetail" catchtouchmove="noop">
  <view class="drawer" catchtap="noop">
    <view class="drawer-head">
      <view class="drawer-word">
        <text class="drawer-term">{{detail.term}}</text>
        <view class="drawer-speaker" data-id="{{detail.wordId}}" data-url="{{detail.audioUrl}}" catchtap="playAudio"><image class="drawer-speaker-icon" src="/assets/ui/icon-volume.svg" mode="aspectFit" /></view>
      </view>
      <view class="drawer-x" bindtap="closeDetail">×</view>
    </view>
    <text class="drawer-phonetic hc-mono" wx:if="{{detail.phonetic}}">{{detail.phonetic}}<text wx:if="{{detail.pos}}"> · {{detail.pos}}</text></text>

    <view class="drawer-divider"></view>
    <text class="drawer-caption">中文释义</text>
    <text class="drawer-meaning">{{detail.meaning}}</text>

    <view class="drawer-ctx">
      <text class="drawer-label">◎ 来源</text>
      <text class="drawer-sentence" wx:if="{{detail.contextSentence}}">“{{detail.contextSentence}}”</text>
      <text class="drawer-source">来源：{{detail.contextSource}}</text>
    </view>

    <view class="drawer-stats">
      <view class="ds">
        <text class="ds-label">当前记忆状态</text>
        <text class="ds-value ds-status">{{detail.statusLabel}}</text>
      </view>
      <view class="ds">
        <text class="ds-label">SM-2 复习间隔</text>
        <text class="ds-value hc-mono">{{detail.interval}} 天</text>
      </view>
      <view class="ds">
        <text class="ds-label">成功复习次数</text>
        <text class="ds-value hc-mono">{{detail.repetitions}} 次</text>
      </view>
      <view class="ds">
        <text class="ds-label">活词激活时间</text>
        <text class="ds-value ds-activated">{{detail.activatedDate}}</text>
      </view>
    </view>

    <view class="drawer-close" bindtap="closeDetail">关闭</view>
  </view>
</view>
