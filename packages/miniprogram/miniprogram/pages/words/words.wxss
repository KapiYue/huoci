.words { padding-top: 24rpx; }

.head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.title { font-size: 40rpx; font-weight: 800; color: var(--text-1); }
.total { display: block; margin-top: 5rpx; font-size: 22rpx; color: var(--text-3); }
.strong-purple { color: var(--brand-text); font-weight: 900; }
.strong-green { color: var(--ok-600); font-weight: 900; }
.context-badge { flex: none; padding: 10rpx 16rpx; border: 2rpx solid var(--border-strong); border-radius: var(--r-full); background: var(--surface); color: var(--brand-text); font-size: 19rpx; font-weight: 800; box-shadow: var(--shadow-xs); }

/* —— 三个筛选 —— */
.tabs {
  display: flex; gap: 12rpx; margin: 24rpx 0;
}
.tab {
  flex: 1; text-align: center; padding: 14rpx 4rpx; border-radius: var(--r-sm);
  border: 2rpx solid var(--border); background: var(--surface);
  font-size: 22rpx; font-weight: 800; color: var(--text-2); box-shadow: var(--shadow-xs);
}
.tab.is-on {
  color: #fff; font-weight: 800;
  background: linear-gradient(90deg, var(--brand-600), var(--indigo-600));
}

.offline {
  padding: 16rpx 24rpx; margin-bottom: 20rpx;
  font-size: 22rpx; color: var(--warn-600);
  background: rgba(245, 158, 11, 0.1); border: 2rpx solid rgba(245, 158, 11, 0.2);
  border-radius: var(--r-sm);
}

/* —— 空态 —— */
.empty { padding: 56rpx 32rpx; text-align: center; }
.empty-title { display: block; font-size: 30rpx; font-weight: 800; color: var(--text-1); }
.empty-sub { display: block; font-size: 24rpx; color: var(--text-3); margin-top: 16rpx; line-height: 1.7; }
.empty-btn {
  margin: 32rpx auto 0; width: 320rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); color: #fff; font-size: 28rpx; font-weight: 700;
  background: linear-gradient(90deg, var(--brand-600), var(--indigo-600));
  box-shadow: var(--shadow-btn);
}
.empty-alt { display: block; margin-top: 24rpx; font-size: 24rpx; color: var(--brand-text); font-weight: 700; }

/* —— 列表 —— */
.row { padding: 24rpx 28rpx; margin-bottom: 18rpx; border-radius: 28rpx; background: var(--surface); }
/* 底座词信息更少，卡片也更轻。这个差异是刻意的（§5.1 全局视觉主张） */
.row.is-base { background: var(--surface); box-shadow: var(--shadow-card); }

.row-top { display: flex; align-items: center; gap: 12rpx; }
.term { font-size: 34rpx; font-weight: 800; color: var(--text-1); }
.phonetic { font-size: 22rpx; color: var(--text-4); }
.speaker { width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; color: var(--brand-text); font-size: 22rpx; border-radius: 50%; background: rgba(168,85,247,.1); }
.speaker-icon { width: 24rpx; height: 24rpx; }
.speaker.is-on { color: var(--brand-600); opacity: .55; }
.grow { flex: 1; }

.meaning { display: block; margin-top: 8rpx; font-size: 26rpx; color: var(--text-2); }

.context-line { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; padding-left: 14rpx; border-left: 4rpx solid #c084fc; }
.context { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20rpx; color: var(--text-3); font-style: italic; }
.source { flex: none; max-width: 46%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; font-size: 19rpx; font-weight: 800; color: var(--brand-text); }
.base-source { display: block; margin-top: 12rpx; text-align: right; font-size: 19rpx; font-weight: 800; color: var(--brand-text); }

.more { padding: 32rpx 0; text-align: center; font-size: 22rpx; color: var(--text-4); }
.tail { height: 40rpx; }

/* —— `[09-03]` 按原型补：搜索框 + 词详情抽屉 —— */
.searchbar {
  display: flex; align-items: center; gap: 14rpx;
  margin: 20rpx 0 4rpx; padding: 0 24rpx; height: 84rpx;
  border-radius: var(--r-full); background: var(--surface); border: 2rpx solid var(--border-strong);
}
.searchbar-icon { font-size: 26rpx; }
.searchbar-input { flex: 1; min-width: 0; font-size: 26rpx; color: var(--text-1); }
.searchbar-clear { font-size: 26rpx; color: var(--text-4); padding: 0 8rpx; }
.ph { color: var(--text-4); }

.mask {
  position: fixed; inset: 0; z-index: 60; background: rgba(2, 6, 23, 0.5);
  display: flex; align-items: center; justify-content: center; padding: 24rpx;
}
.drawer {
  width: 100%; padding: 40rpx 40rpx 38rpx; border-radius: 44rpx;
  background: var(--surface); border: 2rpx solid var(--border); box-shadow: 0 28rpx 80rpx rgba(15,23,42,.25);
}
.drawer-head { display: flex; align-items: center; justify-content: space-between; }
.drawer-word { display: flex; align-items: center; gap: 14rpx; }
.drawer-term { font-size: 42rpx; font-weight: 800; color: var(--text-1); }
.drawer-speaker { width: 46rpx; height: 46rpx; padding: 8rpx; border-radius: 50%; background: #f3e8ff; }
.drawer-speaker-icon { width: 100%; height: 100%; }
.drawer-x { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f1f5f9; color: #94a3b8; font-size: 36rpx; }
.drawer-phonetic { display: block; margin-top: 2rpx; font-size: 22rpx; font-weight: 700; color: var(--brand-text); }
.drawer-divider { height: 2rpx; margin: 22rpx 0; background: #e2e8f0; }
.drawer-caption { display: block; font-size: 20rpx; font-weight: 800; color: var(--text-4); }
.drawer-meaning { display: block; margin-top: 8rpx; font-size: 26rpx; font-weight: 800; color: var(--text-1); line-height: 1.55; }
.drawer-ctx {
  margin: 22rpx 0; padding: 18rpx 20rpx 14rpx; border-radius: var(--r-md);
  background: #faf5ff; border: 2rpx solid #f3e8ff;
}
.drawer-label { display: block; font-size: 20rpx; font-weight: 800; color: var(--brand-600); }
.drawer-sentence { display: block; margin-top: 9rpx; padding: 16rpx; border-radius: 18rpx; font-size: 22rpx; line-height: 1.65; color: var(--text-2); background: rgba(255,255,255,.7); }
.drawer-source { display: block; margin-top: 10rpx; font-size: 19rpx; font-weight: 700; color: var(--text-4); }
.drawer-stats { margin-top: 24rpx; padding: 18rpx 22rpx; border-radius: var(--r-md); background: var(--surface-sunk); border: 2rpx solid var(--border); }
.ds {
  display: flex; align-items: center; justify-content: space-between; min-height: 44rpx;
}
.ds-label { font-size: 20rpx; color: var(--text-4); }
.ds-value { font-size: 21rpx; font-weight: 800; color: var(--text-1); }
.ds-status { color: var(--brand-600); }
.ds-activated { color: var(--ok-500); }
.drawer-close {
  margin-top: 26rpx; height: 80rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 26rpx; background: linear-gradient(90deg,var(--brand-600),#a000ff); color: #fff;
  font-size: 24rpx; font-weight: 800;
}
