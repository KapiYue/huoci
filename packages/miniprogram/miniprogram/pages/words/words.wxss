.words { padding-top: 24rpx; }

.head { display: flex; align-items: baseline; justify-content: space-between; }
.title { font-size: 40rpx; font-weight: 800; color: var(--text-1); }
.total { font-size: 24rpx; color: var(--text-3); }

/* —— 三个筛选 —— */
.tabs {
  display: flex; gap: 8rpx; padding: 8rpx; margin: 24rpx 0;
  background: var(--surface-soft); border: 2rpx solid var(--border);
  border-radius: var(--r-md); box-shadow: var(--shadow-xs);
}
.tab {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: var(--r-sm);
  font-size: 26rpx; font-weight: 700; color: var(--text-2);
}
.tab.is-on {
  color: #fff; font-weight: 800;
  background: linear-gradient(90deg, var(--brand-600), var(--indigo-600));
}

.offline {
  padding: 16rpx 24rpx; margin-bottom: 20rpx;
  font-size: 22rpx; color: var(--warn-600);
  background: rgba(245, 158, 11, 0.1); border: 2rpx solid rgba(245, 158, 11, 0.2);
  border-radius: var(--r-sm);
}

/* —— 空态 —— */
.empty { padding: 56rpx 32rpx; text-align: center; }
.empty-title { display: block; font-size: 30rpx; font-weight: 800; color: var(--text-1); }
.empty-sub { display: block; font-size: 24rpx; color: var(--text-3); margin-top: 16rpx; line-height: 1.7; }
.empty-btn {
  margin: 32rpx auto 0; width: 320rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); color: #fff; font-size: 28rpx; font-weight: 700;
  background: linear-gradient(90deg, var(--brand-600), var(--indigo-600));
  box-shadow: var(--shadow-btn);
}
.empty-alt { display: block; margin-top: 24rpx; font-size: 24rpx; color: var(--brand-text); font-weight: 700; }

/* —— 列表 —— */
.row { padding: 24rpx 28rpx; margin-bottom: 20rpx; }
/* 底座词信息更少，卡片也更轻。这个差异是刻意的（§5.1 全局视觉主张） */
.row.is-base { background: var(--surface-soft); box-shadow: none; }

.row-top { display: flex; align-items: baseline; gap: 16rpx; }
.term { font-size: 34rpx; font-weight: 800; color: var(--text-1); }
.phonetic { font-size: 22rpx; color: var(--text-4); }
.grow { flex: 1; }

.meaning { display: block; margin-top: 8rpx; font-size: 26rpx; color: var(--text-2); }

/* 原句：capture 词的核心资产，比释义更该被看见 */
.context {
  display: block; margin-top: 16rpx; padding: 16rpx 20rpx;
  font-size: 24rpx; line-height: 1.7; color: var(--text-2);
  background: var(--surface-sunk); border-left: 6rpx solid var(--border-strong);
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
}

.source { display: block; margin-top: 14rpx; font-size: 22rpx; color: var(--text-3); }

.more { padding: 32rpx 0; text-align: center; font-size: 22rpx; color: var(--text-4); }
.tail { height: 40rpx; }

/* —— `[09-03]` 按原型补：搜索框 + 词详情抽屉 —— */
.searchbar {
  display: flex; align-items: center; gap: 14rpx;
  margin: 20rpx 0 4rpx; padding: 0 24rpx; height: 84rpx;
  border-radius: var(--r-full); background: var(--surface); border: 2rpx solid var(--border-strong);
}
.searchbar-icon { font-size: 26rpx; }
.searchbar-input { flex: 1; min-width: 0; font-size: 26rpx; color: var(--text-1); }
.searchbar-clear { font-size: 26rpx; color: var(--text-4); padding: 0 8rpx; }
.ph { color: var(--text-4); }

.mask {
  position: fixed; inset: 0; z-index: 60; background: rgba(2, 6, 23, 0.5);
  display: flex; align-items: flex-end;
}
.drawer {
  width: 100%; padding: 40rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  background: var(--surface); border-top: 2rpx solid var(--border);
}
.drawer-head { display: flex; align-items: baseline; gap: 18rpx; }
.drawer-term { font-size: 42rpx; font-weight: 800; color: var(--text-1); }
.drawer-phonetic { font-size: 24rpx; font-weight: 700; color: var(--brand-text); }
.drawer-meaning { display: block; margin-top: 14rpx; font-size: 27rpx; color: var(--text-2); line-height: 1.7; }
.drawer-ctx {
  margin: 24rpx 0; padding: 24rpx; border-radius: var(--r-md);
  background: var(--surface-sunk); border: 2rpx solid var(--border);
}
.drawer-label { display: block; font-size: 20rpx; font-weight: 800; color: var(--brand-text); }
.drawer-sentence { display: block; margin-top: 10rpx; font-size: 25rpx; line-height: 1.8; color: var(--text-2); }
.drawer-sentence-plain { display: block; margin-top: 10rpx; font-size: 22rpx; line-height: 1.8; color: var(--text-3); }
.drawer-source { display: block; margin-top: 10rpx; font-size: 20rpx; font-weight: 700; color: var(--text-3); }
.drawer-stats { display: flex; flex-wrap: wrap; gap: 14rpx; }
.ds {
  width: 48%; padding: 20rpx; border-radius: var(--r-md);
  background: var(--surface-sunk); border: 2rpx solid var(--border);
}
.ds-label { display: block; font-size: 19rpx; color: var(--text-3); }
.ds-value { display: block; margin-top: 6rpx; font-size: 26rpx; font-weight: 800; color: var(--text-1); }
.drawer-close {
  margin-top: 28rpx; height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  font-size: 26rpx; font-weight: 800; color: var(--text-2);
}
