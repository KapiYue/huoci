.hc-page { padding-top: 24rpx; }

.head { display: flex; align-items: baseline; justify-content: space-between; padding: 0 4rpx; }
.head-title { font-size: 44rpx; font-weight: 800; color: var(--text-1); }
.head-count { font-size: 22rpx; font-weight: 700; color: var(--text-3); }

.sec { display: block; margin: 32rpx 4rpx 16rpx; }
.sec-head {
  display: flex; align-items: baseline; justify-content: space-between;
  margin: 36rpx 4rpx 16rpx;
}
.sec-note { font-size: 20rpx; color: var(--text-4); }
.sec-add { font-size: 22rpx; font-weight: 800; color: var(--brand-text); }

/* —— 正在学 —— */
.pack { padding: 28rpx; margin-bottom: 16rpx; border-radius: var(--r-lg); }
.pack-row { display: flex; align-items: baseline; justify-content: space-between; }
.pack-title { font-size: 28rpx; font-weight: 800; color: var(--text-1); }
.pack-total { font-size: 22rpx; font-weight: 700; color: var(--text-3); }
.bar {
  height: 14rpx; margin: 16rpx 0 10rpx; border-radius: var(--r-full);
  background: var(--surface-sunk); overflow: hidden;
}
.bar-fill { height: 100%; border-radius: var(--r-full); background: linear-gradient(90deg, var(--ok-500), var(--ok-600)); }
.pack-sub { display: block; font-size: 20rpx; color: var(--text-3); line-height: 1.6; }

/* —— 推荐 / 考试 / 自建 —— */
.rec {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  padding: 26rpx; margin-bottom: 16rpx; border-radius: var(--r-md);
}
.rec-left { flex: 1; min-width: 0; }
.add-btn {
  flex: none; padding: 12rpx 26rpx; border-radius: var(--r-full);
  background: var(--brand-600); color: #fff; font-size: 22rpx; font-weight: 800;
}
.add-btn.is-on { background: var(--surface-sunk); color: var(--text-3); border: 2rpx solid var(--border-strong); }

.empty { padding: 40rpx 32rpx; border-radius: var(--r-md); text-align: center; }
.empty-title { display: block; font-size: 26rpx; font-weight: 800; color: var(--text-2); }
.empty-sub { display: block; margin-top: 10rpx; font-size: 21rpx; color: var(--text-3); line-height: 1.7; }

.tail { height: 60rpx; }

.mask {
  position: fixed; inset: 0; z-index: 50; background: rgba(2, 6, 23, 0.6);
  display: flex; align-items: center; justify-content: center; padding: 48rpx;
}
.dialog {
  width: 100%; padding: 36rpx 32rpx; border-radius: var(--r-lg);
  background: var(--surface); border: 2rpx solid var(--border);
}
.dlg-title { display: block; font-size: 30rpx; font-weight: 800; color: var(--text-1); }
.field {
  margin-top: 24rpx; height: 88rpx; padding: 0 24rpx;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  background: var(--surface-sunk); font-size: 26rpx; color: var(--text-1);
}
.ph { color: var(--text-4); }
.dlg-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.btn-ghost {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  font-size: 26rpx; font-weight: 700; color: var(--text-2);
}
.btn-ok {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); background: var(--brand-600); color: #fff;
  font-size: 26rpx; font-weight: 800;
}
