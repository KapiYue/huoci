.login { padding-top: 24rpx; display: flex; flex-direction: column; min-height: 100vh; }

/* —— 品牌头 —— */
.brand { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.brand-mark {
  width: 76rpx; height: 76rpx; border-radius: var(--r-md);
  background: linear-gradient(135deg, var(--brand-600), var(--indigo-500) 55%, var(--pink-500));
  color: #fff; font-size: 36rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(147, 51, 234, 0.25);
}
.brand-text { flex: 1; }
.brand-row { display: flex; align-items: center; gap: 12rpx; }
.brand-name { font-size: 32rpx; font-weight: 800; color: var(--text-1); }
.brand-chip {
  font-size: 18rpx; font-weight: 700; padding: 2rpx 12rpx; border-radius: var(--r-full);
  color: var(--ok-600); background: rgba(16, 185, 129, 0.1);
  border: 2rpx solid rgba(16, 185, 129, 0.2);
}
.brand-slogan { font-size: 20rpx; font-weight: 700; color: var(--brand-text); display: block; margin-top: 4rpx; }
.brand-star { color: var(--brand-500); opacity: 0.5; font-size: 28rpx; }

/* —— 三张价值卡 —— */
.value-row { display: flex; gap: 16rpx; margin: 24rpx 0; }
.value-card {
  flex: 1; padding: 20rpx 8rpx; text-align: center;
  background: var(--surface-soft); border: 2rpx solid var(--border);
  border-radius: var(--r-md); box-shadow: var(--shadow-xs);
}
.value-icon {
  width: 48rpx; height: 48rpx; margin: 0 auto 8rpx; border-radius: var(--r-full);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx;
}
.vi-purple { background: rgba(168, 85, 247, 0.1); }
.vi-green { background: rgba(16, 185, 129, 0.1); }
.vi-pink { background: rgba(236, 72, 153, 0.1); }
.value-title { display: block; font-size: 22rpx; font-weight: 800; color: var(--text-1); }
.value-sub { display: block; font-size: 18rpx; color: var(--text-3); margin-top: 4rpx; }

/* —— 分段控件 —— */
.seg {
  display: flex; padding: 8rpx; gap: 8rpx; margin-bottom: 24rpx;
  background: var(--surface-soft); border: 2rpx solid var(--border);
  border-radius: var(--r-md); box-shadow: var(--shadow-xs);
}
.seg-item {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: var(--r-sm);
  font-size: 24rpx; font-weight: 800; color: var(--text-2);
}
.seg-item.is-on { color: #fff; }
.seg-wechat.is-on { background: var(--wechat-500); }
.seg-cijing.is-on { background: var(--indigo-600); }

/* —— 微信面板 —— */
.panel {
  padding: 32rpx 24rpx; text-align: center;
  background: var(--surface); border: 2rpx solid var(--border);
  border-radius: var(--r-md); box-shadow: var(--shadow-xs); margin-bottom: 24rpx;
}
.wx-badge {
  width: 88rpx; height: 88rpx; margin: 0 auto 16rpx; border-radius: var(--r-full);
  background: rgba(16, 185, 129, 0.1); font-size: 40rpx;
  display: flex; align-items: center; justify-content: center;
}
.panel-title { display: block; font-size: 24rpx; font-weight: 800; color: var(--text-1); }
.panel-sub { display: block; font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }

.wechat-btn {
  height: 100rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); color: #fff; font-size: 28rpx; font-weight: 800;
  background: linear-gradient(90deg, var(--wechat-500), var(--wechat-600));
  box-shadow: 0 12rpx 32rpx rgba(16, 185, 129, 0.25);
}
.wechat-btn.is-busy { opacity: 0.7; }

/* —— 词鲸表单 —— */
.form { display: flex; flex-direction: column; }
.label { font-size: 22rpx; font-weight: 800; color: var(--text-2); margin-bottom: 8rpx; }
.field {
  height: 84rpx; padding: 0 24rpx; margin-bottom: 20rpx;
  background: var(--surface); border: 2rpx solid var(--border);
  border-radius: var(--r-sm); font-size: 26rpx; color: var(--text-1);
}
.ph { color: var(--text-4); }
.err { font-size: 22rpx; color: var(--danger-500); margin-bottom: 12rpx; }
.cijing-btn {
  height: 92rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); background: var(--indigo-600); color: #fff;
  font-size: 26rpx; font-weight: 800; box-shadow: 0 10rpx 28rpx rgba(79, 70, 229, 0.25);
}
.form-hint { font-size: 20rpx; color: var(--text-3); margin-top: 16rpx; line-height: 1.6; }

/* —— 底部 —— */
.bottom { margin-top: auto; padding: 32rpx 0 24rpx; }
.agree { display: flex; align-items: flex-start; gap: 12rpx; justify-content: center; }
.checkbox {
  width: 30rpx; height: 30rpx; flex: none; margin-top: 4rpx; border-radius: 8rpx;
  border: 2rpx solid var(--border-strong); background: var(--surface);
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #fff;
}
.checkbox.is-on { background: var(--brand-600); border-color: var(--brand-600); }
.agree-text { font-size: 21rpx; color: var(--text-3); line-height: 1.6; }
.link { color: var(--brand-text); font-weight: 700; }
.guest {
  margin-top: 20rpx; height: 76rpx; display: flex; align-items: center; justify-content: center;
  border: 2rpx solid var(--border-strong); border-radius: var(--r-sm);
  font-size: 22rpx; font-weight: 700; color: var(--text-2);
}

/* —— 授权弹层 —— */
.mask {
  position: fixed; inset: 0; z-index: 100; background: rgba(0, 0, 0, 0.6);
  display: flex; align-items: flex-end; justify-content: center;
}
.sheet {
  width: 100%; padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  background: var(--surface); border-radius: var(--r-lg) var(--r-lg) 0 0;
  border: 2rpx solid var(--border);
}
.sheet-head {
  display: flex; align-items: center; gap: 20rpx; padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--border);
}
.sheet-mark {
  width: 64rpx; height: 64rpx; border-radius: var(--r-full); background: var(--wechat-500);
  color: #fff; font-weight: 800; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.sheet-title { display: block; font-size: 26rpx; font-weight: 800; color: var(--text-1); }
.sheet-sub { display: block; font-size: 20rpx; color: var(--text-3); margin-top: 4rpx; }
.sheet-label { display: block; font-size: 22rpx; font-weight: 800; color: var(--text-2); margin: 24rpx 0 12rpx; }
.avatar-btn {
  display: flex; align-items: center; gap: 20rpx; padding: 16rpx 24rpx;
  background: var(--surface-sunk); border: 2rpx solid var(--border); border-radius: var(--r-md);
}
.avatar { width: 96rpx; height: 96rpx; border-radius: var(--r-full); background: var(--border); }
.avatar-hint { font-size: 22rpx; color: var(--text-3); }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn-ghost {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  border: 2rpx solid var(--border-strong); border-radius: var(--r-sm);
  font-size: 24rpx; font-weight: 700; color: var(--text-2);
}
.btn-ok {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center;
  background: var(--wechat-500); color: #fff; border-radius: var(--r-sm);
  font-size: 24rpx; font-weight: 800;
}
