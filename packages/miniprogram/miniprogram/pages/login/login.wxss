/* S0。还原对象：原型 LoginTab.tsx。主操作按钮压在屏幕下半部分（通勤单手可达）。 */

.hc-page { padding-top: 40rpx; padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx); }

/* —— 品牌头 —— */
.brand {
  display: flex; flex-direction: column; align-items: center;
  padding: 36rpx 32rpx 32rpx; border-radius: 42rpx;
}
.brand-mark-wrap { position: relative; }
.brand-mark {
  width: 112rpx; height: 112rpx; border-radius: 30rpx;
  background: linear-gradient(135deg, var(--brand-600), var(--indigo-500) 55%, var(--pink-500));
  color: #fff; font-size: 50rpx; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(147, 51, 234, 0.25);
}
.brand-badge {
  position: absolute; right: -18rpx; bottom: -8rpx;
  padding: 2rpx 14rpx; border-radius: var(--r-full);
  background: var(--ok-500); color: #fff; font-size: 17rpx; font-weight: 800;
}
.brand-name { margin-top: 22rpx; font-size: 36rpx; font-weight: 900; color: var(--text-1); }
.brand-slogan { margin-top: 8rpx; font-size: 23rpx; font-weight: 800; color: var(--brand-text); }
.brand-note { margin-top: 10rpx; font-size: 20rpx; color: var(--text-3); line-height: 1.6; text-align: center; }

.mascot-slot { margin-top: 22rpx; }

.err {
  margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: var(--r-sm);
  font-size: 23rpx; color: var(--danger-500);
  background: rgba(244, 63, 94, 0.1); border: 2rpx solid rgba(244, 63, 94, 0.28);
}

/* —— 分段切换 —— */
.subtabs {
  display: flex; padding: 6rpx; margin-top: 22rpx;
  border-radius: var(--r-md); background: var(--surface); border: 2rpx solid var(--border);
}
.subtab {
  flex: 1; height: 66rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-sm); font-size: 25rpx; font-weight: 800; color: var(--text-3);
}
.subtab.is-on.is-wechat { background: linear-gradient(90deg, var(--wechat-500), var(--wechat-600)); color: #fff; }
.subtab.is-on.is-cijing { background: var(--indigo-600); color: #fff; }

/* —— 登录面板 —— */
.pane { margin-top: 18rpx; padding: 34rpx 32rpx; border-radius: var(--r-lg); }
.cijing-intro { padding: 22rpx 24rpx; margin-bottom: 22rpx; border-radius: var(--r-md); background: rgba(99,102,241,.08); border: 2rpx solid rgba(99,102,241,.14); }
.cijing-intro-title { display: flex; align-items: center; gap: 8rpx; color: var(--indigo-600); font-size: 22rpx; font-weight: 800; }
.cijing-intro-title image { width: 28rpx; height: 28rpx; flex: none; }
.cijing-intro-sub { display: block; margin-top: 4rpx; color: var(--text-3); font-size: 19rpx; line-height: 1.5; }
.pane-head { text-align: center; }
.pane-icon {
  width: 96rpx; height: 96rpx; margin: 0 auto 16rpx; border-radius: var(--r-md);
  background: rgba(16, 185, 129, 0.12); font-size: 44rpx;
  display: flex; align-items: center; justify-content: center;
}
.pane-icon image { width: 58rpx; height: 58rpx; }
.pane-title { display: block; font-size: 28rpx; font-weight: 800; color: var(--text-1); }
.pane-sub { display: block; margin-top: 10rpx; font-size: 21rpx; color: var(--text-3); line-height: 1.7; }

.highlights { display: flex; gap: 14rpx; margin: 28rpx 0; }
.hl {
  flex: 1; padding: 16rpx 0; border-radius: var(--r-sm); text-align: center;
  background: rgba(16, 185, 129, 0.08); color: var(--ok-600); font-size: 20rpx; font-weight: 800;
}

.wechat-btn {
  width: 100%; height: 88rpx; display: flex; align-items: center; justify-content: center; gap: 14rpx;
  border-radius: var(--r-md); color: #fff; font-size: 27rpx; font-weight: 800;
  background: linear-gradient(90deg, var(--wechat-500), var(--wechat-600));
  box-shadow: 0 12rpx 32rpx rgba(16, 185, 129, 0.28);
}
.button-icon { width: 30rpx; height: 30rpx; flex: none; }

.label { display: block; margin-top: 20rpx; font-size: 22rpx; font-weight: 700; color: var(--text-3); }
.field {
  margin-top: 10rpx; height: 92rpx; padding: 0 24rpx;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  background: var(--surface-sunk); font-size: 27rpx; color: var(--text-1);
}
.ph { color: var(--text-4); }
.form-submit { margin-top: 32rpx; }
.pane .hc-primary-btn { height: 88rpx; font-size: 27rpx; }
.form-hint { display: block; margin-top: 20rpx; font-size: 20rpx; color: var(--text-4); line-height: 1.7; }

/* —— 协议勾选 —— */
.agree {
  display: flex; align-items: flex-start; gap: 16rpx;
  margin-top: 28rpx; padding: 22rpx 24rpx; border-radius: var(--r-md);
  background: var(--surface-soft); border: 2rpx solid var(--border);
}
.agree.is-warn { border-color: var(--danger-500); background: rgba(244, 63, 94, 0.08); }
.checkbox {
  width: 36rpx; height: 36rpx; flex: none; margin-top: 2rpx;
  border-radius: 10rpx; border: 2rpx solid var(--text-4); background: var(--surface);
  color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center;
}
.checkbox.is-on { background: var(--brand-600); border-color: var(--brand-600); }
.agree-text { flex: 1; font-size: 21rpx; color: var(--text-3); line-height: 1.8; }
.link { color: var(--brand-text); font-weight: 800; }
.agree-warn { display: block; margin-top: 12rpx; padding: 0 8rpx; font-size: 20rpx; font-weight: 700; color: var(--danger-500); }

/* —— State A 账号卡 —— */
.acct { margin-top: 28rpx; padding: 32rpx; border-radius: var(--r-lg); }
.acct-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 20rpx; border-bottom: 2rpx solid var(--border);
}
.acct-label { font-size: 22rpx; font-weight: 700; color: var(--text-3); }
.acct-tag {
  padding: 4rpx 16rpx; border-radius: var(--r-full);
  background: var(--st-activated-bg); color: var(--st-activated-fg);
  font-size: 19rpx; font-weight: 800; border: 2rpx solid var(--st-activated-bd);
}
.acct-body { display: flex; align-items: center; gap: 24rpx; padding-top: 24rpx; }
.avatar {
  width: 104rpx; height: 104rpx; flex: none; border-radius: var(--r-full); overflow: hidden;
  background: linear-gradient(135deg, var(--brand-500), var(--indigo-500));
  display: flex; align-items: center; justify-content: center;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-mark { color: #fff; font-size: 40rpx; font-weight: 800; }
.acct-text { flex: 1; min-width: 0; }
.acct-name { display: block; font-size: 32rpx; font-weight: 800; color: var(--text-1); }
.acct-id { display: block; margin-top: 4rpx; font-size: 20rpx; color: var(--text-4); }
.acct-email { display: block; margin-top: 4rpx; font-size: 20rpx; color: var(--brand-text); }
.acct-grid {
  display: flex; gap: 14rpx; margin-top: 28rpx;
  padding-top: 24rpx; border-top: 2rpx solid var(--border);
}
.acct-cell { flex: 1; padding: 18rpx 0; border-radius: var(--r-md); background: var(--surface-sunk); text-align: center; }
.acct-num { display: block; font-size: 30rpx; font-weight: 800; }
.c-purple { color: var(--brand-text); }
.c-amber { color: var(--warn-600); }
.c-blue { color: var(--indigo-600); }
.acct-cell-label { display: block; margin-top: 4rpx; font-size: 19rpx; color: var(--text-3); }

.hc-primary-btn { margin-top: 28rpx; }
.two { display: flex; gap: 20rpx; margin-top: 20rpx; }
.ghost-btn {
  flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); border: 2rpx solid var(--border-strong);
  font-size: 25rpx; font-weight: 800; color: var(--brand-text);
}
.ghost-btn.is-danger { color: var(--danger-500); border-color: rgba(244, 63, 94, 0.4); }

/* —— 纯文字尾巴 —— */
.note { padding: 44rpx 0 8rpx; text-align: center; }
.note-line { display: block; font-size: 21rpx; color: var(--text-4); line-height: 2; }
.note-line.small { font-size: 19rpx; }
.tail { height: 40rpx; }

/* —— React S0 · 微信授权层 —— */
.auth-mask {
  position: fixed; z-index: 1000; inset: 0; box-sizing: border-box;
  display: flex; align-items: flex-end; justify-content: center;
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
  background: rgba(2, 6, 23, .7);
}
.auth-sheet { width: 100%; max-width: 640rpx; padding: 36rpx; border-radius: 40rpx; background: var(--surface); box-shadow: 0 30rpx 80rpx rgba(2, 6, 23, .36); }
.auth-head { display: flex; align-items: center; gap: 20rpx; padding-bottom: 24rpx; border-bottom: 2rpx solid var(--border); }
.auth-app-mark { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: linear-gradient(135deg, var(--brand-600), var(--indigo-500)); color: #fff; font-size: 27rpx; font-weight: 900; }
.auth-head-copy { flex: 1; }
.auth-title { display: block; color: var(--text-1); font-size: 24rpx; font-weight: 800; }
.auth-sub { display: block; margin-top: 3rpx; color: var(--text-4); font-size: 19rpx; }
.auth-body { padding: 24rpx 0 8rpx; }
.auth-label { display: block; color: var(--text-3); font-size: 21rpx; font-weight: 800; }
.avatar-options { display: flex; align-items: center; justify-content: space-around; padding: 18rpx 0 12rpx; }
.avatar-option { width: 76rpx; height: 76rpx; margin: 0; padding: 4rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2rpx solid transparent; border-radius: 25rpx; background: transparent; opacity: .7; }
.avatar-option image { width: 68rpx; height: 68rpx; border-radius: 22rpx; }
.avatar-blue image { filter: hue-rotate(35deg); }
.avatar-pink image { filter: hue-rotate(300deg); }
.avatar-amber image { filter: hue-rotate(75deg); }
.avatar-option::after { border: 0; }
.avatar-option.is-on { border-color: var(--brand-500); background: rgba(168, 85, 247, .08); opacity: 1; transform: scale(1.05); }
.nickname-label { margin-top: 12rpx; }
.auth-nickname { box-sizing: border-box; width: 100%; height: 76rpx; margin-top: 10rpx; padding: 0 20rpx; border: 2rpx solid var(--border-strong); border-radius: 18rpx; background: var(--surface-sunk); color: var(--text-1); font-size: 23rpx; }
.auth-actions { display: flex; gap: 16rpx; padding-top: 18rpx; }
.auth-action { flex: 1; height: 78rpx; margin: 0; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 23rpx; font-weight: 800; }
.auth-action::after { border: 0; }
.auth-deny { background: var(--surface-sunk); color: var(--text-3); }
.auth-allow { background: var(--wechat-500); color: #fff; box-shadow: 0 8rpx 20rpx rgba(16,185,129,.23); }

.legal-mask { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(2,6,23,.66); }
.legal-dialog { width: 100%; max-height: 78vh; padding: 34rpx; border-radius: 36rpx; background: var(--surface); }
.legal-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 2rpx solid var(--border); }
.legal-title { color: var(--text-1); font-size: 30rpx; font-weight: 900; }
.legal-x { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--text-4); font-size: 34rpx; }
.legal-body { max-height: 640rpx; padding-top: 8rpx; }
.legal-section { display: block; margin-top: 22rpx; color: var(--text-1); font-size: 23rpx; font-weight: 800; }
.legal-copy { display: block; margin-top: 8rpx; color: var(--text-3); font-size: 21rpx; line-height: 1.7; }
.legal-close { width: 100%; height: 84rpx; margin-top: 26rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: linear-gradient(90deg,var(--brand-600),var(--indigo-600)); color: #fff; font-size: 24rpx; font-weight: 800; }
.guest-entry { margin-top: 22rpx; text-align: center; }
