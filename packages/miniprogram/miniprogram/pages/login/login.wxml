<!-- S0 · 身份屏。还原对象：`docs/prototype/src/components/LoginTab.tsx`。
     `[09-03]` 按原型改回「品牌头 + 分段切换 + 价值点 + 协议勾选」——
     09-02 那版削成「两个并列入口」是按 §5.3 S0 削的，09-03 裁决改以原型为准。
     ⚠️ 仍然不加：**游客模式**（没有账号就没有跨端的词）· App 下载引导。 -->
<scroll-view class="hc-page {{themeClass}}" scroll-y>

  <!-- 品牌头 -->
  <view class="brand hc-card">
    <view class="brand-mark-wrap">
      <view class="brand-mark">活</view>
      <text class="brand-badge">官方正版</text>
    </view>
    <text class="brand-name">活词 · ActiveWords</text>
    <text class="brand-slogan">撞见生词 · 智能捕获 · 永久激活</text>
    <text class="brand-note">不靠死记硬背。在你真实读到的那句话里遇见它，再把它练到能说出口。</text>
  </view>

  <view class="mascot-slot">
    <mascot message="{{mascotMessage}}" />
  </view>

  <!-- 失败态：行内提示不用 toast —— 通勤场景一晃就没了，用户不知道刚才发生了什么 -->
  <view class="err" wx:if="{{error}}">{{error}}</view>

  <!-- State A · 已登录（从「我的 → 登录/账号管理」进来时） -->
  <block wx:if="{{loggedIn && !switching}}">
    <view class="acct hc-card">
      <view class="acct-head">
        <text class="acct-label">✓ 当前登录账号</text>
        <text class="acct-tag">{{isBound ? '已绑定词鲸' : '微信已授权'}}</text>
      </view>
      <view class="acct-body">
        <view class="avatar">
          <image class="avatar-img" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
          <text class="avatar-mark" wx:else>活</text>
        </view>
        <view class="acct-text">
          <text class="acct-name">{{displayName}}</text>
          <text class="acct-id hc-mono">ID: {{shortId}}</text>
          <text class="acct-email" wx:if="{{email}}">绑定邮箱：{{email}}</text>
        </view>
      </view>
      <view class="acct-grid">
        <view class="acct-cell">
          <text class="acct-num hc-mono c-purple">{{summary.activated_count}}</text>
          <text class="acct-cell-label">已激活活词</text>
        </view>
        <view class="acct-cell">
          <text class="acct-num hc-mono c-amber">{{summary.streak_days}} 天</text>
          <text class="acct-cell-label">连续学习</text>
        </view>
        <view class="acct-cell">
          <text class="acct-num hc-mono c-blue">{{credits}}</text>
          <text class="acct-cell-label">AI 额度（次）</text>
        </view>
      </view>
    </view>

    <button class="hc-primary-btn" bindtap="goToday">进入今日复习 →</button>
    <view class="two">
      <view class="ghost-btn" bindtap="startSwitch">切换其他账号</view>
      <view class="ghost-btn is-danger" bindtap="logout">退出登录</view>
    </view>
  </block>

  <!-- State B · 登录表单 -->
  <block wx:else>
    <view class="subtabs">
      <view class="subtab {{tab === 'wechat' ? 'is-on is-wechat' : ''}}" data-v="wechat" bindtap="switchTab">微信登录</view>
      <view class="subtab {{tab === 'cijing' ? 'is-on is-cijing' : ''}}" data-v="cijing" bindtap="switchTab">词鲸账号</view>
    </view>

    <!-- 微信一键：**一次点击**，不插头像/昵称授权弹层 -->
    <view class="pane hc-card" wx:if="{{tab === 'wechat'}}">
      <view class="pane-head">
        <view class="pane-icon">💬</view>
        <text class="pane-title">微信快捷登录</text>
        <text class="pane-sub">微信官方授权，一次点击就进去；学习进度存在云端，换设备也在。</text>
      </view>
      <view class="highlights">
        <text class="hl">✓ 免记密码</text>
        <text class="hl">✓ 进度实时存</text>
        <text class="hl">✓ 官方授权</text>
      </view>
      <button class="wechat-btn" bindtap="loginWithWeChat" loading="{{loading}}">微信一键快捷登录</button>
    </view>

    <!-- 老词鲸用户：邮箱 + 密码。**不提供邮箱注册入口**（词鲸强制邮箱验证，转化必死） -->
    <view class="pane hc-card" wx:else>
      <text class="label">词鲸注册邮箱</text>
      <input class="field" type="text" value="{{email}}" bindinput="onEmail"
             placeholder="name@example.com" placeholder-class="ph" confirm-type="next" />
      <text class="label">密码</text>
      <input class="field" password value="{{password}}" bindinput="onPassword"
             placeholder="词鲸账号密码" placeholder-class="ph" confirm-type="done"
             bindconfirm="loginWithPassword" />
      <button class="hc-primary-btn form-submit" bindtap="loginWithPassword" loading="{{loading}}">
        登录并同步
      </button>
      <text class="form-hint">没有词鲸账号？切回「微信登录」一键进入。小程序不提供邮箱注册。</text>
    </view>

    <!-- 协议勾选 -->
    <view class="agree {{agreeNotice ? 'is-warn' : ''}}">
      <view class="checkbox {{agreed ? 'is-on' : ''}}" bindtap="toggleAgree">{{agreed ? '✓' : ''}}</view>
      <view class="agree-text">
        <text>我已阅读并同意</text>
        <text class="link" bindtap="openTerms">《用户服务协议》</text>
        <text>与</text>
        <text class="link" bindtap="openPrivacy">《个人信息保护政策》</text>
      </view>
    </view>
    <text class="agree-warn" wx:if="{{agreeNotice}}">请先勾选同意协议，再继续登录</text>

    <view class="cancel" wx:if="{{loggedIn && switching}}" bindtap="cancelSwitch">
      取消并返回原账号（{{displayName}}）
    </view>
  </block>

  <!-- 纯文字，不放链接、不放二维码、不放按钮 -->
  <view class="note">
    <text class="note-line">词鲸 App（iOS）已上架 App Store</text>
    <text class="note-line">词鲸网页端与 Chrome 扩展已上线</text>
    <text class="note-line small">活词微信小程序 · 数据遵循微信个人信息保护规范</text>
  </view>

  <view class="tail"></view>
</scroll-view>
