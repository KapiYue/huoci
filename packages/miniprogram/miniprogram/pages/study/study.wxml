<!-- ② 学习卡片（push 页）。`design.md` §5.4 S5 —— P2 的命门 -->
<view class="study {{themeClass}}">

  <!-- 顶部进度 -->
  <view class="topbar" wx:if="{{!done && !loading && !error}}">
    <view class="progress">
      <text class="progress-text hc-mono">{{index + 1}} / {{queue.length}}</text>
      <progress class="bar" percent="{{percent}}" stroke-width="5" activeColor="#9333ea" backgroundColor="#ede9fe" />
    </view>
    <view class="hc-badge st-{{card.status}}">{{card.badge}} {{card.statusLabel}}</view>
    <view class="close" bindtap="back" aria-label="关闭">×</view>
  </view>

  <view class="finish" wx:if="{{loading}}">
    <text class="finish-title">正在准备学习队列…</text>
  </view>

  <view class="finish" wx:elif="{{error}}">
    <text class="finish-title">学习队列没有加载成功</text>
    <text class="finish-sub">{{error}}</text>
    <button class="hc-primary-btn finish-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- 卡片 -->
  <view class="card hc-card" wx:if="{{!done && !loading && !error && card}}" bindtap="tapCard">
    <view class="card-body">
      <!-- 语境优先：正面直接给原句、把词挖空。底座词没有 cloze，自动落到下面的 classic 分支 -->
      <block wx:if="{{cardMode === 'context' && card.cloze && !revealed}}">
        <view class="cloze-label">🧭 语境推理 · 猜猜挖空生词</view>
        <view class="cloze-guide">结合当前场景语境回忆目标生词…</view>
        <view class="cloze">"{{card.cloze}}"</view>
        <view class="ctx-source"><view class="dot"></view><text class="source-text">{{card.contextSource}}</text></view>
        <view class="flip-hint">点击卡片翻看生词与释义</view>
      </block>

      <block wx:else>
        <view class="term-row">
          <view>
            <text class="term">{{card.term}}</text>
            <view class="phonetic-row">
              <text class="phonetic hc-mono">{{card.phonetic}}</text>
              <view class="speak" catchtap="playAudio"><image class="speak-icon" src="/assets/ui/icon-volume.svg" mode="aspectFit" /></view>
            </view>
          </view>
          <text class="pos hc-mono" wx:if="{{card.pos}}">{{card.pos}}</text>
        </view>
      </block>

      <!-- 背面 -->
      <view class="answer" wx:if="{{revealed}}">
        <view class="divider"></view>
        <text class="meaning">{{card.meaning}}</text>
        <view class="ctx" wx:if="{{card.contextSentence}}">“{{card.contextSentence}}”</view>
        <view class="ctx-source"><view class="dot"></view><text class="source-text">{{card.contextSource}}</text></view>
        <view class="example" wx:elseif="{{card.exampleEn}}">
          <text class="ex-en">"{{card.exampleEn}}"</text>
          <text class="ex-zh" wx:if="{{card.exampleZh}}">{{card.exampleZh}}</text>
        </view>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="card-foot" catchtap="noop">
      <button class="hc-primary-btn" wx:if="{{!revealed}}" bindtap="reveal">翻看背面 <text class="key-hint">（空格键）</text></button>
      <view class="rates" wx:else>
        <view class="rate rate-{{item.rating}}" wx:for="{{ratings}}" wx:key="rating"
              data-rating="{{item.rating}}" bindtap="rate">
          <text class="rate-emoji">{{item.emoji}}</text>
          <text class="rate-label">{{item.label}}</text>
          <text class="rate-hint hc-mono">{{item.hint}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 完成页 -->
  <view class="finish" wx:if="{{done}}">
    <view class="finish-mark">✓</view>
    <text class="finish-title">今日复习完成！</text>
    <text class="finish-sub">完成 {{reviewed}} 个词的激活循环<text wx:if="{{activated > 0}}">，新激活 {{activated}} 个活词</text></text>

    <view class="finish-stats">
      <view class="fs hc-card">
        <text class="fs-label">已复习词汇</text>
        <text class="fs-num hc-mono c-purple">{{reviewed}}</text>
      </view>
      <view class="fs hc-card">
        <text class="fs-label">新激活活词</text>
        <text class="fs-num hc-mono c-green">+{{activated}}</text>
      </view>
    </view>

    <view class="finish-note" wx:if="{{pending > 0}}">
      有 {{pending}} 条还没发出去，联网后会自动补上，不会丢。
    </view>

    <!-- R5：这一轮里有底座词才给这句。**不打断学习**，只在结束页出现一次 -->
    <view class="reader-hint" wx:if="{{showReaderHint}}" bindtap="openReader">
      <text class="reader-hint-title">想让卡片带上原句？</text>
      <text class="reader-hint-sub">读一篇你自己的文章，点词就能连原句和来源一起收下 →</text>
    </view>

    <button class="hc-primary-btn finish-btn" bindtap="back">完成并返回今日</button>
  </view>

  <!-- 空队列 -->
  <view class="finish" wx:if="{{!done && queue.length === 0 && !loading && !error}}">
    <view class="finish-mark">🌙</view>
    <text class="finish-title">今天没有要学的了</text>
    <text class="finish-sub">明天这个时候，到期的词会自己排好队等你</text>
    <button class="hc-primary-btn finish-btn" bindtap="back">返回今日主页</button>
  </view>
</view>
