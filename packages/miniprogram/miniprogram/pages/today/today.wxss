.hc-page { height: 100vh; padding-top: 24rpx; }

.offline {
  margin-bottom: 20rpx; padding: 16rpx 24rpx; border-radius: var(--r-sm);
  font-size: 22rpx; color: var(--warn-600);
  background: rgba(245, 158, 11, 0.1); border: 2rpx solid rgba(245, 158, 11, 0.25);
}

/* —— 用户条 —— */
.userbar { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx 4rpx; margin-bottom: 22rpx; }
.userbar-left { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.avatar {
  width: 84rpx; height: 84rpx; flex: none; border-radius: var(--r-full);
  background: linear-gradient(45deg, #c084fc, #f472b6 52%, #a5b4fc);
  display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 4rpx;
}
.avatar.is-vip { box-shadow: 0 0 0 4rpx var(--warn-500); }
.avatar-img { width: 100%; height: 100%; border-radius: var(--r-full); background: #ede9fe; }
.avatar-mark { color: #fff; font-size: 32rpx; font-weight: 800; }
.userbar-text { min-width: 0; }
.userbar-name-row { display: flex; align-items: center; gap: 10rpx; }
.userbar-name {
  font-size: 28rpx; font-weight: 800; color: var(--text-1);
  max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.vip-pill {
  padding: 0 12rpx; border-radius: var(--r-full); font-size: 18rpx; font-weight: 800;
  background: linear-gradient(90deg, #fbbf24, #eab308); color: #0f172a; line-height: 1.9;
}
.vip-pill.is-off { background: var(--surface-sunk); color: var(--text-3); border: 2rpx solid var(--border-strong); }
.userbar-sub { display: block; margin-top: 2rpx; font-size: 21rpx; font-weight: 700; color: var(--brand-text); }
.member-entry {
  flex: none; padding: 10rpx 22rpx; border-radius: var(--r-full);
  border: 2rpx solid var(--border-strong); background: var(--surface);
  font-size: 22rpx; font-weight: 800; color: var(--brand-text); box-shadow: var(--shadow-xs);
}
.assistant-row { margin-bottom: 26rpx; }

/* —— 今日记忆队列 —— */
.hero { position: relative; margin: 0 0 28rpx; padding: 36rpx 32rpx 38rpx; border-radius: var(--r-xl); overflow: hidden; }
.hero::before { content: ''; position: absolute; width: 280rpx; height: 280rpx; right: -120rpx; top: -130rpx; border-radius: 50%; background: rgba(168,85,247,.12); }
.hero::after { content: '✦'; position: absolute; right: 120rpx; top: 22rpx; color: rgba(168,85,247,.36); font-size: 24rpx; }
.hero-head,.hero-line,.hero-note,.hero-btn,.hero-done { position: relative; z-index: 1; }
.hero-test { position: relative; z-index: 1; display: block; margin-bottom: 16rpx; padding: 8rpx 14rpx; border-radius: var(--r-sm); color: var(--warn-600); background: rgba(245,158,11,.12); font-size: 19rpx; font-weight: 800; }
.hero-head { display: flex; align-items: center; justify-content: space-between; }
.hero-tag { display: flex; align-items: center; gap: 10rpx; }
.hero-dot { width: 14rpx; height: 14rpx; border-radius: var(--r-full); background: var(--brand-600); }
.hero-tag-text { font-size: 22rpx; font-weight: 800; letter-spacing: 2rpx; color: var(--brand-text); }
.hero-cap { font-size: 21rpx; font-weight: 700; color: var(--text-3); }

.hero-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10rpx; margin-top: 20rpx; }
.num { font-size: 56rpx; font-weight: 800; line-height: 1.1; }
.num-due { color: var(--brand-text); }
.num-new { font-size: 48rpx; color: var(--indigo-600); }
.num-label { font-size: 24rpx; font-weight: 700; color: var(--text-2); }
.num-sep { color: var(--text-4); margin: 0 4rpx; }
.hero-note { display: block; margin-top: 12rpx; font-size: 21rpx; color: var(--text-3); }

.hero-btn { width: 100% !important; min-width: 100%; margin: 32rpx 0 0 !important; height: 92rpx; font-size: 28rpx; }
.play-icon { width: 30rpx; height: 30rpx; }

.login-celebration { position: fixed; inset: 0; z-index: 120; pointer-events: none; overflow: hidden; }
.welcome-pop { position: absolute; left: 50%; top: 31%; transform: translate(-50%,-50%); padding: 20rpx 30rpx; border-radius: var(--r-full); background: rgba(126,34,206,.94); color: #fff; font-size: 24rpx; font-weight: 900; box-shadow: 0 18rpx 52rpx rgba(126,34,206,.32); animation: welcome-pop 1.8s ease both; white-space: nowrap; }
.confetti { position: absolute; top: -30rpx; width: 15rpx; height: 30rpx; border-radius: 5rpx; background: #a855f7; animation: confetti-fall 1.55s cubic-bezier(.2,.75,.4,1) both; }
.confetti:nth-child(3n) { background: #22c55e; transform: rotate(18deg); }
.confetti:nth-child(3n+1) { background: #f59e0b; }
.confetti:nth-child(3n+2) { background: #ec4899; }
.confetti:nth-child(1) { left: 5%; animation-delay: .02s; } .confetti:nth-child(2) { left: 11%; animation-delay: .22s; }
.confetti:nth-child(3) { left: 17%; animation-delay: .1s; } .confetti:nth-child(4) { left: 23%; animation-delay: .34s; }
.confetti:nth-child(5) { left: 29%; animation-delay: .16s; } .confetti:nth-child(6) { left: 36%; animation-delay: .04s; }
.confetti:nth-child(7) { left: 42%; animation-delay: .3s; } .confetti:nth-child(8) { left: 48%; animation-delay: .12s; }
.confetti:nth-child(9) { left: 54%; animation-delay: .24s; } .confetti:nth-child(10) { left: 60%; animation-delay: .06s; }
.confetti:nth-child(11) { left: 66%; animation-delay: .28s; } .confetti:nth-child(12) { left: 72%; animation-delay: .14s; }
.confetti:nth-child(13) { left: 78%; animation-delay: .36s; } .confetti:nth-child(14) { left: 83%; animation-delay: .08s; }
.confetti:nth-child(15) { left: 88%; animation-delay: .2s; } .confetti:nth-child(16) { left: 93%; animation-delay: .32s; }
.confetti:nth-child(17) { left: 39%; animation-delay: .4s; } .confetti:nth-child(18) { left: 69%; animation-delay: .42s; }
@keyframes confetti-fall { from { opacity: 0; transform: translateY(-30rpx) rotate(0); } 12% { opacity: 1; } to { opacity: 0; transform: translateY(110vh) rotate(640deg); } }
@keyframes welcome-pop { 0% { opacity: 0; transform: translate(-50%,-50%) scale(.72); } 18%,72% { opacity: 1; transform: translate(-50%,-50%) scale(1); } 100% { opacity: 0; transform: translate(-50%,-50%) scale(.92); } }
.hero-done {
  margin-top: 32rpx; height: 104rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); background: var(--surface-sunk);
  font-size: 28rpx; font-weight: 700; color: var(--text-3);
}

/* —— 连续学习 / 已激活（并排两张） —— */
.facts { display: flex; gap: 20rpx; }
.fact { flex: 1; min-width: 0; min-height: 220rpx; padding: 26rpx; border-radius: var(--r-lg); display: flex; flex-direction: column; justify-content: space-between; }
.fact-head { display: flex; align-items: center; justify-content: space-between; }
.fact-label { font-size: 22rpx; font-weight: 700; color: var(--text-2); }
.fact-icon { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
.fact-icon image { width: 32rpx; height: 32rpx; }
.fact-icon-flame { background: rgba(245,158,11,.14); }
.fact-icon-spark { background: rgba(16,185,129,.14); }
.fact-num-row { display: flex; align-items: baseline; gap: 8rpx; margin: 12rpx 0; }
.fact-num { font-size: 44rpx; font-weight: 800; line-height: 1.1; }
.fact-num-streak { color: var(--warn-500); }
.fact-num-act { color: var(--ok-600); }
.fact-unit { font-size: 22rpx; font-weight: 700; color: var(--text-3); }

.weekdots {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 12rpx; border-top: 2rpx solid var(--border);
}
.weekdot {
  width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center;
  border-radius: var(--r-full); font-size: 18rpx; color: var(--text-4); background: var(--surface-sunk);
}
.weekdot.is-on { background: var(--brand-600); color: #fff; font-weight: 700; }

.fact-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 12rpx; border-top: 2rpx solid var(--border);
}
.fact-foot-text { font-size: 19rpx; font-weight: 700; color: var(--text-3); }
.fact-foot-arrow { font-size: 20rpx; color: var(--text-4); }

/* —— 今日小目标 —— */
.tasks { display: flex; gap: 20rpx; }
.task { flex: 1; min-width: 0; padding: 24rpx; border-radius: var(--r-lg); }
.task-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.task-icon { width: 34rpx; height: 34rpx; }
.task-tag { padding: 2rpx 12rpx; border-radius: var(--r-sm); font-size: 18rpx; font-weight: 800; }
.task-tag-reader { color: var(--brand-text); background: var(--st-captured-bg); }
.task-tag-search { color: var(--indigo-600); background: var(--st-learning-bg); }
.task-title { display: block; font-size: 24rpx; font-weight: 800; color: var(--text-1); }
.task-sub { display: block; margin-top: 4rpx; font-size: 19rpx; color: var(--text-3); }

.section-head {
  display: flex; align-items: center; justify-content: space-between;
  margin: 36rpx 4rpx 16rpx;
}
.section-more { font-size: 22rpx; font-weight: 800; color: var(--brand-text); }

/* —— 词条 —— */
.word { padding: 24rpx 26rpx; margin-bottom: 16rpx; border-radius: var(--r-md); }
.word-main { min-width: 0; }
.word-row { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.word-term { font-size: 28rpx; font-weight: 800; color: var(--text-1); }
.word-phonetic { font-size: 20rpx; font-weight: 700; color: var(--brand-text); }
.word-speaker { width: 34rpx; height: 34rpx; padding: 4rpx; border-radius: var(--r-full); background: rgba(168,85,247,.1); flex: none; }
.word-speaker-icon { width: 100%; height: 100%; display: block; }
.word-speaker.is-on { opacity: .45; }
.word-grow { flex: 1; }
.word-meaning {
  display: block; font-size: 22rpx; color: var(--text-2); margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.word-source { display: block; margin-top: 8rpx; text-align: right; font-size: 19rpx; font-weight: 800; color: var(--brand-text); }

.empty { padding: 48rpx 32rpx; text-align: center; border-radius: var(--r-md); }
.empty-title { display: block; font-size: 28rpx; font-weight: 800; color: var(--text-2); }
.empty-sub { display: block; font-size: 22rpx; color: var(--text-3); margin-top: 12rpx; line-height: 1.6; }

.tail { height: 40rpx; }
