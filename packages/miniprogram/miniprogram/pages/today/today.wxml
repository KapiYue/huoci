<!-- ① 今日 · App 的主屏。
     还原对象：`docs/prototype/src/components/TodayTab.tsx`（09-03 裁决：**原型为准**，
     与 design.md §5 冲突时以原型为准 —— 用户条 / AI 额度入口 / 今日小目标
     这三块是 09-03 按原型加回来的，不是遗漏，别再当超范围删掉。
     ⚠️ 原型这里还有「VIP 角标」和「会员中心」，**09-03 裁决不卖 Credits 之后一并去掉了**
     —— 没有会员这个东西了，留个角标只会让用户找一个不存在的付费页）。
     仍然不加：App 下载引导 · banner/插屏广告（那两条是微信审核红线，不是审美） -->
<view class="login-celebration" wx:if="{{celebrate}}" aria-hidden="true">
  <view class="confetti" wx:for="{{confettiPieces}}" wx:key="*this"></view>
  <view class="welcome-pop">登录成功，欢迎回来 ✨</view>
</view>

<scroll-view class="hc-page hc-immersive-page {{themeClass}}" scroll-y enable-back-to-top refresher-enabled="{{true}}"
             refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullRefresh">

  <!-- 离线 / 待补发提示。通勤断网是常态，不能一片空白也不能假装成功 -->
  <view class="offline" wx:if="{{stale || pending > 0}}">
    <text wx:if="{{pending > 0}}">有 {{pending}} 条复习还没同步，联网后会自动补上</text>
    <text wx:else>当前离线，展示的是上次的数据</text>
  </view>

  <!-- 用户条：头像 · 昵称 · VIP 角标 · 会员中心（原型 TodayTab 顶部） -->
  <view class="userbar">
    <view class="userbar-left" bindtap="openProfile">
      <view class="avatar">
        <image class="avatar-img" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
        <image class="avatar-img" wx:else src="/assets/ui/avatar.svg" mode="aspectFill" />
      </view>
      <view class="userbar-text">
        <view class="userbar-name-row">
          <text class="userbar-name">{{displayName}}</text>
          <text class="vip-pill" wx:if="{{releaseFeatures.membership}}">VIP</text>
        </view>
        <text class="userbar-sub">{{greeting}}</text>
      </view>
    </view>
    <!-- `[09-03]` 原型这里是「会员中心 💎」。**不卖 Credits 之后没有「会员」这个东西了**，
         入口改成额度本身：点进去是「额度从哪来」，不是充值页 -->
    <view class="member-entry" wx:if="{{releaseFeatures.membership || releaseFeatures.aiQuota}}" bindtap="openVip">会员中心 💎</view>
  </view>

  <view class="assistant-row">
    <mascot title="活词小助手 · 艾拉" action="换一句 ↻" message="{{mascotMessage}}" bind:action="rotateMascot" />
  </view>

  <!-- 今日记忆队列 -->
  <view class="hero hc-card">
    <text class="hero-test" wx:if="{{backlogTestMode}}">临时积压测试：只改首页显示，不改真实队列</text>
    <view class="hero-head">
      <view class="hero-tag">
        <view class="hero-dot"></view>
        <text class="hero-tag-text">今日记忆队列</text>
      </view>
      <text class="hero-cap hc-mono">最多 20 词 / 轮</text>
    </view>

    <view class="hero-line">
      <text class="num num-due hc-mono">{{summary.due_count}}</text>
      <text class="num-label">个到期积压</text>
      <text class="num-sep">·</text>
      <text class="num num-new hc-mono">{{summary.new_count}}</text>
      <text class="num-label">个新词可学</text>
    </view>
    <text class="hero-note" wx:if="{{hasBacklog}}">积压共 {{backlogTotal}} 个；本轮只排入 {{total}} 个，先复习到期词，再补充新词</text>
    <text class="hero-note" wx:else>本轮已排入 {{total}} 个；先复习到期词，再补充新词</text>

    <button class="hc-primary-btn hero-btn" wx:if="{{total > 0 || allowCardModeReplay}}" bindtap="startStudy">
      <image class="play-icon" src="/assets/ui/icon-play-white.svg" mode="aspectFit" />
      <text wx:if="{{total > 0}}">开始今日学习（{{total}} 词）</text>
      <text wx:else>重新测试学习卡片模式</text>
    </button>
    <view class="hero-done" wx:else>今天的队列已清空</view>
  </view>

  <!-- 连续学习 / 已激活活词（原型的两张并排卡） -->
  <view class="facts">
    <view class="fact hc-card">
      <view class="fact-head">
        <text class="fact-label">连续学习</text>
        <view class="fact-icon fact-icon-flame"><image src="/assets/ui/icon-flame.svg" /></view>
      </view>
      <view class="fact-num-row">
        <text class="fact-num fact-num-streak hc-mono">{{summary.streak_days}}</text>
        <text class="fact-unit">天</text>
      </view>
      <!-- 一周七格。**只陈述事实，不做奖励**：不放彩带、断了不弹「别灰心」 -->
      <view class="weekdots">
        <text class="weekdot {{item.on ? 'is-on' : ''}}" wx:for="{{weekDots}}" wx:key="label">{{item.label}}</text>
      </view>
    </view>

    <view class="fact hc-card" bindtap="openWords">
      <view class="fact-head">
        <text class="fact-label">已经激活活词</text>
        <view class="fact-icon fact-icon-spark"><image src="/assets/ui/icon-sparkles.svg" /></view>
      </view>
      <view class="fact-num-row">
        <text class="fact-num fact-num-act hc-mono">{{summary.activated_count}}</text>
        <text class="fact-unit">个</text>
      </view>
      <view class="fact-foot">
        <text class="fact-foot-text">稳固期 ≥ 21 天</text>
        <text class="fact-foot-arrow">→</text>
      </view>
    </view>
  </view>

  <!-- 今日小目标 · 场景触达（原型 TodayTab 的 Mini Tasks） -->
  <view class="section-head">
    <text class="hc-section-title">今日小目标 · 场景触达</text>
    <text class="section-more">{{miniTaskLeft}} 项待完成</text>
  </view>
  <view class="tasks">
    <view class="task hc-card task-reader" bindtap="openReader">
      <view class="task-head">
        <image class="task-icon" src="/assets/ui/icon-book.svg" mode="aspectFit" />
        <text class="task-tag task-tag-reader">场景阅读</text>
      </view>
      <text class="task-title">贴文章 · 点词收录</text>
      <text class="task-sub">自动绑定原句与出处</text>
    </view>

    <view class="task hc-card task-search" bindtap="openSearch">
      <view class="task-head">
        <image class="task-icon" src="/assets/ui/tab-search-on.svg" mode="aspectFit" />
        <text class="task-tag task-tag-search">查词抓取</text>
      </view>
      <text class="task-title">精准查词入库</text>
      <text class="task-sub">一键加入我的活词</text>
    </view>
  </view>

  <!-- 最近遇到的词。数据源是 S6 的 `recent` 筛选（见 today.ts），不是今日队列 -->
  <view class="section-head">
    <text class="hc-section-title">最近遇到的词</text>
    <text class="section-more" bindtap="openWords">查看全部（{{summary.total_words}}）→</text>
  </view>

  <view class="empty hc-card" wx:if="{{recent.length === 0}}">
    <text class="empty-title">还没有词</text>
    <text class="empty-sub">去「查词」搜一个，或者贴一篇你自己在读的文章点词收录。</text>
  </view>

  <view class="word hc-card" wx:for="{{recent}}" wx:key="wordId" bindtap="openWords">
    <view class="word-main">
      <view class="word-row">
        <text class="word-term">{{item.term}}</text>
        <text class="word-phonetic hc-mono">{{item.phonetic}}</text>
        <view class="word-speaker {{playingId === item.wordId ? 'is-on' : ''}}"
              data-id="{{item.wordId}}" data-url="{{item.audioUrl}}" catchtap="playAudio">
          <image class="word-speaker-icon" src="/assets/ui/icon-volume.svg" mode="aspectFit" />
        </view>
        <view class="word-grow"></view>
        <view class="hc-badge st-{{item.status}}">{{item.badge}} {{item.statusLabel}}</view>
      </view>
      <text class="word-meaning">{{item.meaning}}</text>
      <text class="word-source">{{item.contextSource}}</text>
    </view>
  </view>

  <view class="tail"></view>
</scroll-view>
