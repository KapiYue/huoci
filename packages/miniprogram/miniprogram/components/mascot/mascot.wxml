<!-- 活词小助手。直接复刻 prototype/src/components/CuteMascot.tsx 的 SVG 几何与渐变；
     使用本地静态资源，避免 data-uri 在不同基础库中的兼容差异。 -->
<view class="mascot">
  <view class="bot"><image class="bot-image" src="/assets/ui/mascot.svg" mode="aspectFit" /></view>

  <view class="bubble" wx:if="{{message}}">
    <view class="bubble-head" wx:if="{{title}}">
      <view class="bubble-title"><image class="bubble-title-icon" src="/assets/ui/icon-sparkles-purple.svg" mode="aspectFit" /><text>{{title}}</text></view>
      <text class="bubble-action" wx:if="{{action}}" bindtap="tapAction">{{action}}</text>
    </view>
    <text class="bubble-text">{{message}}</text>
  </view>
</view>
