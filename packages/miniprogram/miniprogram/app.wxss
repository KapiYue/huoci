@import './styles/tokens.wxss';

page {
  background-color: var(--bg-bottom);
  background-image:
    radial-gradient(circle at 10% 7%, rgba(244, 114, 182, .16) 0, rgba(216, 180, 254, .12) 18%, transparent 37%),
    radial-gradient(circle at 92% 10%, rgba(147, 197, 253, .17) 0, rgba(199, 210, 254, .12) 20%, transparent 39%),
    radial-gradient(circle at 18% 95%, rgba(251, 207, 232, .19) 0, rgba(233, 213, 255, .10) 24%, transparent 43%),
    radial-gradient(circle, rgba(168, 85, 247, .10) 1rpx, transparent 1rpx),
    linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 45%, var(--bg-bottom) 100%);
  background-size: auto, auto, auto, 28rpx 28rpx, auto;
  background-attachment: fixed;
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input, textarea, scroll-view { box-sizing: border-box; }

/* 微信默认给 button 一堆样式，统一抹掉后再自己画 */
button {
  padding: 0;
  margin: 0;
  font-size: inherit;
  line-height: inherit;
  background: transparent;
  border-radius: 0;
}
button::after { border: none; }

.hc-page {
  min-height: 100vh;
  padding: 0 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  animation: hc-page-enter .2s ease-out both;
}

@keyframes hc-page-enter {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: none; }
}

.hc-immersive-page { padding-top: calc(env(safe-area-inset-top) + 88rpx) !important; }

.hc-card {
  background: var(--surface-soft);
  border: 2rpx solid var(--border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}

@media (prefers-color-scheme: dark) {
  page {
    background-image:
      radial-gradient(circle at 8% 8%, rgba(88, 28, 135, .34) 0, transparent 36%),
      radial-gradient(circle at 94% 12%, rgba(30, 27, 75, .45) 0, transparent 40%),
      radial-gradient(circle at 20% 96%, rgba(46, 16, 101, .38) 0, transparent 43%),
      radial-gradient(circle, rgba(192, 132, 252, .12) 1rpx, transparent 1rpx),
      linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 45%, var(--bg-bottom) 100%);
  }
}

.hc-primary-btn {
  width: 100%;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: var(--r-md);
  background: linear-gradient(90deg, var(--brand-600), var(--indigo-600) 55%, var(--brand-700));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: var(--shadow-btn);
}
.hc-primary-btn.is-pressed { transform: scale(0.985); opacity: 0.95; }

.hc-mono { font-variant-numeric: tabular-nums; font-feature-settings: 'tnum'; }

.hc-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--r-full);
  border: 2rpx solid transparent;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.6;
}
.st-captured   { color: var(--st-captured-fg);   background: var(--st-captured-bg);   border-color: var(--st-captured-bd); }
.st-learning   { color: var(--st-learning-fg);   background: var(--st-learning-bg);   border-color: var(--st-learning-bd); }
.st-remembered { color: var(--st-remembered-fg); background: var(--st-remembered-bg); border-color: var(--st-remembered-bd); }
.st-activated  { color: var(--st-activated-fg);  background: var(--st-activated-bg);  border-color: var(--st-activated-bd); }
.st-mastered   { color: var(--st-mastered-fg);   background: var(--st-mastered-bg);   border-color: var(--st-mastered-bd); }

.hc-section-title {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-1);
}

.hc-muted { color: var(--text-3); }
