.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 90;
  display: flex; align-items: center;
  height: calc(env(safe-area-inset-bottom) + 108rpx);
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--surface, #fff);
  border-top: 2rpx solid var(--border, #f3e8ff);
  box-shadow: 0 -8rpx 30rpx rgba(147, 51, 234, 0.06);
}
.tab {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 4rpx; color: var(--text-3, #64748b);
}
.tab.is-on { color: var(--brand-700, #7e22ce); }
.tab-icon { font-size: 36rpx; line-height: 1; }
.tab-text { font-size: 19rpx; font-weight: 700; }
