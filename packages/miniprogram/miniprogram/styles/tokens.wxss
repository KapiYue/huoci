  --st-mastered-fg: #fcd34d;
  --st-mastered-bg: rgba(69, 26, 3, 0.8);
  --st-mastered-bd: rgba(180, 83, 9, 0.8);

  --rate-1-fg: #fda4af;
  --rate-1-bg: rgba(76, 5, 25, 0.4);
  --rate-1-bd: rgba(159, 18, 57, 0.5);
  --rate-2-fg: #fcd34d;
  --rate-2-bg: rgba(69, 26, 3, 0.4);
  --rate-2-bd: rgba(146, 64, 14, 0.5);
  --rate-3-fg: #6ee7b7;
  --rate-3-bg: rgba(2, 44, 34, 0.4);
  --rate-3-bd: rgba(6, 95, 70, 0.5);
  background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-mid) 45%, var(--bg-bottom) 100%);
  color: var(--text-1);
