{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["miniprogram-api-typings"],
    "declaration": false,
    "sourceMap": false,
    "baseUrl": "miniprogram",
    "paths": { "@shared/*": ["shared/*"] },
    "noEmit": true
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["miniprogram/miniprogram_npm"]
}
