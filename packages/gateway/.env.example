# 网关环境变量。放服务器上，**不进仓库**。
# HUOCI_WX_APPSECRET 与 SUPABASE_SECRET_KEY 泄露 = 全站沦陷，与私钥同级对待。

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

HUOCI_WX_APPID=
HUOCI_WX_APPSECRET=

# 派生密码的 HMAC 密钥。生成：openssl rand -hex 32
# 轮转时不要直接换掉它 —— 换了所有存量微信用户都登不进来。
# 正确做法是升 hc_wechat_identities.secret_version，让老用户在下次登录时惰性重派生。
HUOCI_WX_DERIVE_SECRET=

# 合成邮箱的域。改了它 = 所有存量微信用户的邮箱变了 = 全都登不进来，**别改**。
HUOCI_WX_EMAIL_DOMAIN=wx.joy-coder.cn

# 内容安全（msg_sec_check）总开关。不填 = 开。
# 填 off / 0 / false / no 才关，关掉时 AI 文本一律放行且每次都打日志。
# 这是微信侧故障或额度耗尽时的**应急旁路**，不是常态，用完记得改回来。
# HUOCI_WX_SECCHECK=on
